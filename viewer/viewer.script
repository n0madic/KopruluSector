-- Map viewer (plan §7 phase 1, item 7): any catalog mission, terrain from its .kpm through
-- the tileset template collections (collection proxies, ADR 0004).
--
-- Keys: arrows pan, drag pans, N / P next / previous mission, M switches the scale mode,
-- W / R toggle the walkability / region debug overlays. The minimap shows the view; a click
-- on it moves the camera. Static units and doodads come from the mission's resource packs.
-- Settings: viewer.mission = <index from 1> starts there; viewer.autotest = 1 loads every
-- mission and, on HTML5, checks the rendered terrain byte for byte: every megatile fully
-- inside the view must have the CRC-32 the converter computed from VX4/VR4
-- (generated/viewer/<tileset>.mcrc), and every isolated static image of a probe animation
-- in the top-left view must show its GRP frame's indices (viewer/sprite_check.lua). Results
-- are printed as "SPIKE ..." lines (tools/spike.sh viewer web).
local loader = require("game.data.loader")
local mission_data = require("game.data.mission")
local terrain_data = require("game.data.terrain")
local terrain = require("presentation.terrain")
local lookup = require("presentation.lookup_textures")
local crc32 = require("game.data.crc32")
local bytes = require("game.data.bytes")
local report = require("spikes.common.report")
local readback = require("spikes.common.readback")
local dat = require("game.data.dat")
local grpmeta_data = require("game.data.grpmeta")
local scripts = require("game.data.scripts")
local palettes = require("game.data.palettes")
local kpf = require("game.data.kpf")
local strings = require("game.data.strings")
local world_images = require("presentation.backend.world_images")
local images = require("presentation.images")
local image = require("game.images.image")
local map_world = require("viewer.map_world")
local play_world = require("viewer.play_world")
local effect_scene = require("viewer.effect_scene")
local browser = require("viewer.browser")
local world_lookups = require("presentation.world_lookups")
local bars = require("presentation.bars")
local palette = require("presentation.palette")
local events = require("game.simulation.events")
local clock = require("game.simulation.clock")
local sprite_check = require("viewer.sprite_check")
local loads = require("viewer.loads")
local core = require("game.images.core")

local TILESETS = {}
for i = 0, 7 do TILESETS[i + 1] = terrain_data.TILESETS[i] end
local PAN_PER_FRAME = 8 -- world pixels
local SETTLE_FRAMES = 3 -- frames between a camera move and a readback
local INDEX_TARGET = 1 -- the index render target is the first framebuffer the render script creates
local SCALE_MODES = { "auto", "integer", "sharp" }
local BRIGHTNESS_STEP = 20 -- the B key steps the brightness option through 60..140
-- Backend slots per material family. Every image record can draw overwriting; the other
-- families take what a scene needs, and images past them are left out and reported.
local FAMILY_CAPACITY = { overwrite = core.IMAGES, dest = 3000, distort = 1000 }
local REMAP_PATH = "/kp/viewer_remap.texturec"
local TABLES_PATH = "/kp/viewer_tables.texturec"
local AUTOTEST_TICKS = 48 -- the autotest's second composition check runs after this many ticks
-- Composition checks after the draw effects: mid-way through the cloak thresholds (the
-- parameter moves every 4 ticks) and after the cloak/decloak method switches (32 ticks).
local EFFECT_TICKS = { 12, 40 }
local BROWSER_CHECKS = 12 -- images the autotest shows in the animation browser (first mission)
local BROWSER_STRIDE = 83 -- image ids between them
local BROWSER_TICKS = 16
local VIRTUAL_PATH = "virtual" -- draw-log GRP of virtual images (health bars, boxes)
local FOG_PATH = "/kp/overlay_fog.texturec"
local CLICK_SLOP = 4 -- screen pixels a press may move and still count as a click
-- The play checks (viewer.play_check = n): a box over units of a scenario, a right click away
-- from them, then the game's steps until `steps`. 1: the five Marines of marine_group;
-- 2: a group of twelve Marines of bench_200, whose paths are searched in one step.
local PLAY_CHECKS = {
	{ mission = "scenarios/marine_group", box = { 980, 1080, 1090, 1150 }, target = { 1300, 1110 }, steps = 140 },
	{ mission = "scenarios/bench_200", box = { 990, 1350, 1520, 1370 }, target = { 1700, 1150 }, steps = 140 },
}
local PLAY_CHECK_LINGER = 3 -- seconds the final state stays on screen
local MESSAGE_SECONDS = 7 -- a game message's time on screen (the default 7000 ms of 0x46ac90)
local MESSAGE_LINES = 4
-- Window events for the clocks (game/simulation/clock.lua on_window); mobile devices pause without the focus.
local WINDOW_EVENTS = {
	[window.WINDOW_EVENT_FOCUS_LOST] = clock.FOCUS_LOST, [window.WINDOW_EVENT_FOCUS_GAINED] = clock.FOCUS_GAINED,
	[window.WINDOW_EVENT_ICONFIED] = clock.ICONIFIED, [window.WINDOW_EVENT_DEICONIFIED] = clock.DEICONIFIED,
}
local AUTOPAUSE = { Android = true, ["iPhone OS"] = true }
local HEALTH_BAR_METHOD = 11

local MSG_STATS = hash("kp_stats")
local PROXY_LOADED = hash("proxy_loaded")
local PROXY_UNLOADED = hash("proxy_unloaded")

-- The catalog missions, then the phase-3 scenarios (generated/scenarios/index.txt), which show
-- their base map's minimap and overlays. kpm = the mission file, map = the map's name for those.
local function read_index()
	local out = {}
	for line in sys.load_resource("/generated/missions/index.txt"):gmatch("[^\n]+") do
		local name, tileset, width, height = line:match("^(%S+) (%d+) (%d+) (%d+)$")
		out[#out + 1] = { name = name, kpm = "/generated/missions/" .. name .. ".kpm", map = name,
			tileset = tonumber(tileset), width = tonumber(width), height = tonumber(height) }
	end
	local scenarios = sys.load_resource("/generated/scenarios/index.txt")
	for line in (scenarios or ""):gmatch("[^\n]+") do
		local name, base, tileset, width, height = line:match("^(%S+) (%S+) (%d+) (%d+) (%d+)$")
		out[#out + 1] = { name = "scenarios/" .. name, kpm = "/generated/scenarios/" .. name .. ".kpm", map = base,
			tileset = tonumber(tileset), width = tonumber(width), height = tonumber(height) }
	end
	return out
end

local function proxy(name)
	return msg.url("#proxy_" .. name)
end

local function tileset(self, index)
	local name = TILESETS[index + 1]
	local cached = self.tilesets[name]
	if not cached then
		local bytes = loader.read("/generated/data/tilesets/" .. name .. ".kpd")
		cached = terrain_data.parse_tileset(bytes, name)
		cached.name, cached.bytes = name, bytes
		self.tilesets[name] = cached
	end
	return cached
end

local function clamp_camera(self)
	local m = self.mission
	if not m or not self.world_w then return end
	local max_x = math.max(0, m.width * terrain.TILE - self.world_w)
	local max_y = math.max(0, m.height * terrain.TILE - self.world_h)
	self.cam_x = math.max(0, math.min(max_x, math.floor(self.cam_x + 0.5)))
	self.cam_y = math.max(0, math.min(max_y, math.floor(self.cam_y + 0.5)))
	-- cam_x/cam_y: top-left of the view in map pixels; the render camera is bottom-left in world space.
	msg.post("@render:", "kp_camera", { x = self.cam_x, y = terrain.world_y(self.cam_y) - self.world_h })
	msg.post("minimap#minimap", "kp_minimap_view", { x = self.cam_x, y = self.cam_y, w = self.world_w, h = self.world_h })
end

-- The map rectangle the index target shows (draw_list.build's view), nil before the render
-- script reported its size.
local function view_rect(self)
	if not self.world_w then return nil end
	local v = self.view or {}
	self.view = v
	v.left, v.top, v.right, v.bottom = self.cam_x, self.cam_y, self.cam_x + self.world_w, self.cam_y + self.world_h
	return v
end

-- The presentation of whatever the viewer animates: the browsed image or the map scene.
local function active_presentation(self)
	return self.browser and self.browser_presentation or self.presentation
end

-- Remap and destination table rows of the mission's tileset (presentation/world_lookups.lua).
local function upload_lookups(self, tileset_index)
	local l = world_lookups.build(self.palettes, tileset_index, self.ts.rgb, { outline_color = effect_scene.OUTLINE_COLOR })
	msg.post("@render:", "kp_textures", { remap = lookup.remap(REMAP_PATH, l.remap), tables = lookup.remap(TABLES_PATH, l.tables),
		trans50 = l.trans50, bright = l.bright })
	self.rows = l.rows
end

-- Ends the scene and with it the animation browser, whose presentation reads the scene's
-- frame table and writes its backend.
local function destroy_scene(self)
	self.browser, self.browser_presentation = nil, nil
	if self.backend then
		msg.post("@render:", "kp_world_textures", {})
		self.backend:destroy()
		self.bars:destroy()
		resource.release(self.frame_table.path)
	end
	self.backend, self.frame_table, self.presentation, self.scene, self.bars = nil, nil, nil, nil, nil
	self.scene_images = {}
end

-- The mission's units and doodads as animated sprites (viewer/map_world.lua) drawn through
-- the world_images backend from the loaded packs' atlases.
local function build_scene(self)
	destroy_scene(self)
	local t0 = socket.gettime()
	upload_lookups(self, self.mission.tileset)
	local atlases = {}
	for index, atlas in ipairs(self.grpmeta.atlases) do
		atlases[index] = self.packs:loaded(atlas.pack) and ("/generated/atlases/" .. atlas.name .. ".a.texturesetc") or false
	end
	self.frame_table = world_images.frame_table(atlases, #self.grpmeta.atlases, "viewer")
	self.backend = world_images.new({ tag = "viewer", empty = self.frame_table.empty, families = {
		{ name = images.OVERWRITE, mesh = msg.url("scene#images"), capacity = FAMILY_CAPACITY.overwrite },
		{ name = images.DEST, mesh = msg.url("scene#images_dest"), capacity = FAMILY_CAPACITY.dest },
		{ name = images.DISTORT, mesh = msg.url("scene#images_distort"), capacity = FAMILY_CAPACITY.distort },
	} })
	self.bars = bars.new(self.palettes.thpbar, "viewer")
	local textures = {}
	for slot, path in pairs(self.frame_table.textures) do textures[slot] = path end
	msg.post("@render:", "kp_world_textures", { atlases = textures, image_data = self.backend.data_path,
		frame_table = self.frame_table.path, bars = self.bars.path })
	local ctx = { dat = self.dat, grp = self.grpmeta, iscript = self.iscript, tileset = self.ts }
	local scene, bar_of
	if self.playing then
		scene = play_world.build({ dat = self.dat, blobs = { dat = self.blobs.dat, grp = self.blobs.grp,
			iscript = self.blobs.iscript, mission = self.mission_bytes, tileset = self.ts.bytes } })
		bar_of = function(unit) return play_world.bar_of(scene, unit) end
		if scene.failed then report.line(("play %s: %s"):format(self.missions[self.current].name, scene.failed)) end
	else
		scene = map_world.build(self.mission, ctx)
		bar_of = function(unit) return map_world.bar_of(scene, unit) end
	end
	self.scene = scene
	if not scene.world then
		-- The game did not start: nothing to draw, the error stays on screen.
		self.scene_ready = true
		return
	end
	self.presentation = images.new(scene.world, self.grpmeta, self.frame_table, self.rows,
		{ bars = self.bars, bar_of = bar_of })
	local t1 = socket.gettime()
	local drawn, layers = self.presentation:sync(self.backend, self.scene_images, view_rect(self))
	-- The animated map scene and the browser tick on the viewer's clock; a game on its mission manager's.
	self.clock = clock.new()
	self.messages = {}
	collectgarbage()
	local entry = self.missions[self.current]
	report.line(("scene %s%s: %d images drawn, %d destination layers, %d units, %d creation errors, packs %s, build %.0f ms, first sync %.1f ms, Lua heap %.0f KB")
		:format(entry.name, self.playing and " (play)" or "", drawn, layers, #self.scene.units, self.scene.errors,
			table.concat(self.mission.packs, ","),
			(t1 - t0) * 1000, (socket.gettime() - t1) * 1000, collectgarbage("count")))
	self.scene_ready = true
end

-- Loads the mission's resource packs (PACK) through their collection factories and unloads the
-- others (ADR 0004); the scene is built when all are loaded (viewer/loads.lua).
local function load_packs(self)
	self.packs:want(self.mission.packs)
end

-- Autotest: the mission after `index`, or the summary after the last one (set below).
local autotest_after

local function show(self, index)
	self.requested = index
	local entry = self.missions[index]
	local t0 = socket.gettime()
	local bytes = loader.read(entry.kpm)
	local m = mission_data.parse(bytes, entry.name)
	local ts = tileset(self, m.tileset)
	local t1 = socket.gettime()
	local ids, bad_cell = terrain_data.import(m, ts)
	if not ids then
		-- The shown mission stays; N/P continue from this one.
		report.line(("mission %s: tile at cell %d selects a missing CV5 group"):format(entry.name, bad_cell))
		self.load_failures = self.load_failures + 1
		if self.autotest then autotest_after(self, index) end
		return
	end
	self.current = index
	self.mission, self.mission_bytes, self.ids, self.ts = m, bytes, ids, ts
	self.scene_ready = false
	self.packs:cancel()
	destroy_scene(self)
	self.timing = { load_ms = (t1 - t0) * 1000, import_ms = (socket.gettime() - t1) * 1000 }
	self.cam_x, self.cam_y = 0, 0
	self.fill_token = self.fill_token + 1
	self.fill_pending = self.proxies:want(ts.name)
end

-- The index target's texels x..x+w-1, y..y+h-1 (GL rows, bottom-up), or nil, error: on
-- HTML5 the GL readback; on desktop engines with native/kp_capture the window's frame, which
-- the autotest draws with an identity grey palette and without GUI (self.index_capture).
local function read_target(self, x, y, w, h)
	if report.is_web then return readback.red(INDEX_TARGET, x, y, w, h) end
	if not self.index_capture then return nil, "no index readback on this platform" end
	if self.scale ~= math.floor(self.scale) then return nil, "the view is not at an integer scale" end
	return rawget(_G, "kp_capture").read_index(x, y, w, h, self.scale,
		sys.get_config_int("viewer.screenshot_bottom_up", 0) == 1)
end

-- The palette of the screen, or the identity grey palette of the index capture.
local IDENTITY_PALETTE
local function set_palette(self, rgb)
	if self.index_capture then
		if not IDENTITY_PALETTE then
			local t = {}
			for i = 0, 255 do t[i + 1] = string.char(i, i, i) end
			IDENTITY_PALETTE = table.concat(t)
		end
		rgb = IDENTITY_PALETTE
	end
	lookup.palette(rgb)
end

-- Byte check of the index target against the per-megatile CRCs.
local function check_view(self, label)
	local w, h = self.world_w, self.world_h
	local index, err = read_target(self, 0, 0, w, h)
	if not index then return report.line("check " .. label .. ": readback failed: " .. tostring(err)) end
	local crcs = self.crcs[self.ts.name]
	if not crcs then
		crcs = sys.load_resource("/generated/viewer/" .. self.ts.name .. ".mcrc")
		self.crcs[self.ts.name] = crcs
	end
	local m, tile = self.mission, terrain.TILE
	local checked, bad = 0, 0
	for cy = math.ceil(self.cam_y / tile), math.floor((self.cam_y + h) / tile) - 1 do
		for cx = math.ceil(self.cam_x / tile), math.floor((self.cam_x + w) / tile) - 1 do
			if cx < m.width and cy < m.height then
				local rows = {}
				for yy = 0, tile - 1 do
					-- GL rows are bottom-up: map row py is target row cam_y + h - 1 - py.
					local r = self.cam_y + h - 1 - (cy * tile + yy)
					local start = r * w + cx * tile - self.cam_x
					rows[yy + 1] = index:sub(start + 1, start + tile)
				end
				local mega = self.ids[cy * m.width + cx] % 32768
				checked = checked + 1
				if crc32.of(table.concat(rows)) ~= bytes.u32(crcs, 4 * mega) then bad = bad + 1 end
			end
		end
	end
	report.line(("check %s %s: view %dx%d at %d,%d, %d megatiles, %d mismatches")
		:format(self.missions[self.current].name, label, w, h, self.cam_x, self.cam_y, checked, bad))
	self.total_checked = self.total_checked + checked
	self.total_bad = self.total_bad + bad
end

-- Readback check of the isolated probe images fully inside the view.
local function check_sprites(self)
	local w, h = self.world_w, self.world_h
	local images, rotated, pixels, bad = 0, 0, 0, 0
	-- Only images meeting the view can cover one that lies inside it.
	local in_view = {}
	for _, img in ipairs(self.scene_images) do
		if img.left < self.cam_x + w and img.top < self.cam_y + h and img.left + img.w > self.cam_x
			and img.top + img.h > self.cam_y then
			in_view[#in_view + 1] = img
		end
	end
	for _, img in ipairs(sprite_check.isolated(in_view)) do
		local frames = self.probe[self.grpmeta.grps[img.grp].animation]
		local f = frames and frames[img.frame]
		local x, y = img.left - self.cam_x, img.top - self.cam_y
		if f and f.w > 0 and x >= 0 and y >= 0 and x + f.w <= w and y + f.h <= h then
			local got, err = read_target(self, x, h - y - f.h, f.w, f.h)
			if not got then return report.line("sprites: readback failed: " .. tostring(err)) end
			local n, b = sprite_check.compare(f, img.flip, got)
			images, pixels, bad = images + 1, pixels + n, bad + b
			if self.frame_table.rotated[img.global] then rotated = rotated + 1 end
		end
	end
	if images > 0 then
		report.line(("sprites %s: %d images (%d rotated in the atlas), %d pixels, %d mismatches")
			:format(self.missions[self.current].name, images, rotated, pixels, bad))
	end
	self.sprite_images, self.sprite_rotated = self.sprite_images + images, self.sprite_rotated + rotated
	self.sprite_pixels, self.sprite_bad = self.sprite_pixels + pixels, self.sprite_bad + bad
end

-- Composition check: the whole index target of the view and the draw list of
-- the images meeting it. tools/viewer_compose_check.py rebuilds the view on the CPU with
-- the original kernels from the retail GRPs and tilesets and compares the CRC.
local function check_compose(self, label)
	local w, h = self.world_w, self.world_h
	local index, err = read_target(self, 0, 0, w, h)
	if not index then return report.line("compose: readback failed: " .. tostring(err)) end
	local rows = {}
	for r = 0, h - 1 do rows[r + 1] = index:sub((h - 1 - r) * w + 1, (h - r) * w) end -- GL rows are bottom-up
	local name = self.missions[self.current].name .. label
	local drawn = {}
	for _, img in ipairs(self.scene_images) do
		local x, y = img.left - self.cam_x, img.top - self.cam_y
		if x < w and y < h and x + img.w > 0 and y + img.h > 0 then drawn[#drawn + 1] = img end
	end
	report.line(("compose %s %d %d %d %d %d %.0f %d"):format(name, self.mission.tileset, self.cam_x, self.cam_y, w, h,
		crc32.of(table.concat(rows)), #drawn))
	if name == sys.get_config_string("viewer.compose_dump", "") then
		for r = 1, h do
			report.line(("pixels %s %d %s"):format(name, r - 1, (rows[r]:gsub(".", function(c)
				return string.format("%02x", c:byte()) end))))
		end
	end
	local plan, windows = self.backend.plan, {}
	for k = 1, plan.count do windows[k] = plan.windows[k].rank .. ":" .. plan.windows[k].layers end
	local p = active_presentation(self)
	report.line(("plan %s %d %d %d %d %s"):format(name, plan.count, plan.layers, p.degraded, p.overflow,
		table.concat(windows, ",")))
	for _, img in ipairs(drawn) do
		local path = img.virtual and VIRTUAL_PATH or self.grpmeta.grps[img.grp].path
		report.line(("draw %s %d %d %d %d %s %d %d %d %d %d %d %d"):format(name, img.rank, img.method, img.owner, img.param,
			path, img.frame, img.left, img.top, img.flip and 1 or 0, img.row, img.window, img.layer))
		if img.method == HEALTH_BAR_METHOD then
			-- The bar's pixels as presentation/bars.lua drew them ("--" where nothing is drawn).
			local px, hex = self.bars.pixels, {}
			for y = 0, img.h - 1 do
				for x = 0, img.w - 1 do
					local o = ((img.row * bars.ROWS + y) * bars.WIDTH + x) * 4
					hex[#hex + 1] = px[o + 4] > 0 and string.format("%02x", px[o + 1]) or "--"
				end
			end
			report.line(("bar %s %d %d %d %s"):format(name, img.rank, img.w, img.h, table.concat(hex)))
		end
	end
	self.composed = self.composed + 1
end

-- Animation browser keys: image, animation and direction steps, restart.
local BROWSER_KEYS = {
	[hash("image_prev")] = function(b) b:next_image(-1) end,
	[hash("image_next")] = function(b) b:next_image(1) end,
	[hash("anim_prev")] = function(b) b:next_anim(-1) end,
	[hash("anim_next")] = function(b) b:next_anim(1) end,
	[hash("dir_prev")] = function(b) b:next_direction(-1) end,
	[hash("dir_next")] = function(b) b:next_direction(1) end,
	[hash("restart")] = function() end,
}

local function next_mission(self, step)
	local n = #self.missions
	show(self, (self.requested - 1 + step) % n + 1)
end

-- The tick benchmark (viewer.tick_bench = <scenario>; plan §10): the scenario's game replays
-- the original's command and interface logs from its golden file
-- (tests/golden/oracle/scenarios/<scenario>.lua, in the bundle's custom resources), one object
-- step per frame, and the wall time of each step (visibility included) is logged (os.clock
-- counts the engine's other threads too). On a phone
-- this is the budget's own measure: Defold runs LuaJIT without the JIT there.
local BENCH_SLOWEST = 8

local function bench_start(self, name)
	local oracle = require("tools.lua.oracle")
	local golden = assert((loadstring or load)(sys.load_resource("/tests/golden/oracle/scenarios/" .. name .. ".lua")))()
	local function read(path) return sys.load_resource("/" .. path) end
	local commands = {}
	for _, r in ipairs(golden.commands) do
		commands[#commands + 1] = { turn = r.turn, player = r.player,
			bytes = (r.bytes:gsub("%x%x", function(h) return string.char(tonumber(h, 16)) end)) }
	end
	local g = oracle.start_mission(read, "generated/" .. golden.mission .. ".kpm", golden.seed, golden.expansion)
	local last = 0
	for step in pairs(golden.steps) do last = math.max(last, step) end
	self.bench = { name = name, g = g, run = oracle.runner(g, commands, golden.ui), step = 1, last = last,
		times = {}, at = {} }
end

local function bench_step(self)
	local b = self.bench
	if b.step < b.last then
		b.step = b.step + 1
		local t0 = socket.gettime()
		b.run.to(b.step)
		b.times[#b.times + 1] = (socket.gettime() - t0) * 1000
		b.at[#b.times] = b.step
		return
	end
	local order = {}
	for k = 1, #b.times do order[k] = k end
	table.sort(order, function(x, y) return b.times[x] > b.times[y] end)
	local slowest = {}
	for k = 1, math.min(BENCH_SLOWEST, #order) do slowest[k] = ("%d: %.1f"):format(b.at[order[k]], b.times[order[k]]) end
	local sorted, sum = {}, 0
	for k, t in ipairs(b.times) do sorted[k], sum = t, sum + t end
	table.sort(sorted)
	local function pct(p) return sorted[math.max(1, math.ceil(#sorted * p))] end
	local units, n = 0, b.g.lists.active.head
	while n ~= 0 do
		units = units + 1
		n = b.g.u.next[n]
	end
	report.line(("tick bench %s: %d steps, %d active units; mean %.3f ms, median %.3f ms, p99 %.3f ms, max %.3f ms; JIT %s; native core")
		:format(b.name, #sorted, units, sum / #sorted, pct(0.5), pct(0.99), sorted[#sorted],
			(jit and jit.status and jit.status()) and "on" or "off"))
	report.line("tick bench slowest steps (step: ms): " .. table.concat(slowest, ", "))
	self.bench = nil
	report.done()
end

function init(self)
	msg.post(".", "acquire_input_focus")
	self.missions = read_index()
	self.tilesets, self.crcs = {}, {}
	self.proxy_names = {}
	for _, name in ipairs(TILESETS) do self.proxy_names[hash("proxy_" .. name)] = name end
	self.proxies = loads.proxies({
		load = function(name) msg.post(proxy(name), "async_load") end,
		unload = function(name) msg.post(proxy(name), "unload") end,
		enable = function(name) msg.post(proxy(name), "enable") end,
	})
	self.packs = loads.packs({
		load = function(name, done)
			collectionfactory.load("packs#" .. name, function(_, _, ok) done(ok) end)
		end,
		unload = function(name) collectionfactory.unload("packs#" .. name) end,
		ready = function(failed)
			for name in pairs(failed) do report.line("pack " .. name .. " failed to load") end
			build_scene(self)
		end,
	})
	self.fill_token, self.load_failures = 0, 0
	self.overlay = "off"
	-- The data files: parsed for the presentation, as bytes for the native game (play mode).
	self.blobs = { dat = loader.read("/generated/data/dat.kpd"), grp = loader.read("/generated/data/grpmeta.kpd"),
		iscript = loader.read("/generated/data/iscript.kpd") }
	self.dat = dat.parse(self.blobs.dat, "dat.kpd")
	self.grpmeta = grpmeta_data.parse(self.blobs.grp, "grpmeta.kpd")
	self.iscript = scripts.parse_iscript(self.blobs.iscript, "iscript.kpd")
	self.palettes = palettes.parse(loader.read("/generated/data/palettes.kpd"), "palettes.kpd")
	self.stat_txt = kpf.parse(loader.read("/generated/data/strings.kpd"), "strings.kpd"):section("STAT")
	self.messages, self.message_count = {}, 0
	local autopause = AUTOPAUSE[sys.get_sys_info().system_name] or false
	window.set_listener(function(listener, event)
		local kind = WINDOW_EVENTS[event]
		if not kind then return end
		if listener.clock then listener.clock:on_window(kind, autopause) end
		if listener.playing and listener.scene and listener.scene.on_window then listener.scene:on_window(kind, autopause) end
	end)
	self.scale_mode = 1
	self.autotest = sys.get_config_int("viewer.autotest", 0) == 1
	-- Desktop engines with native/kp_capture read the index target from the window.
	self.index_capture = self.autotest and not report.is_web and rawget(_G, "kp_capture") ~= nil
	if self.index_capture then msg.post("@render:", "kp_world_only", { on = true }) end
	local check = PLAY_CHECKS[sys.get_config_int("viewer.play_check", 0)]
	if check then self.play_check = { stage = 1, spec = check } end
	local after = tonumber(sys.get_config_string("viewer.screenshot_after", "")) -- seconds
	if after then self.shot_after = after end
	-- viewer.autotest_count limits the autotest to that many missions from the first (0: all).
	local count = sys.get_config_int("viewer.autotest_count", 0)
	if self.autotest then self.probe = sprite_check.parse(sys.load_resource("/generated/viewer/sprite_probe.bin")) end
	self.total_checked, self.total_bad, self.composed = 0, 0, 0
	self.sprite_images, self.sprite_rotated, self.sprite_pixels, self.sprite_bad = 0, 0, 0, 0
	self.scene_images = {}
	self.sounds, self.sounds_in_view = 0, 0
	self.pan = { x = 0, y = 0 }
	msg.post("@render:", "kp_scale_mode", { mode = SCALE_MODES[self.scale_mode] })
	report.line(("viewer: %d missions"):format(#self.missions))
	local first = math.max(1, math.min(#self.missions, sys.get_config_int("viewer.mission", 1)))
	if self.play_check then
		for index, entry in ipairs(self.missions) do
			if entry.name == self.play_check.spec.mission then first = index end
		end
	end
	self.autotest_first = first
	-- The autotest covers the catalog missions only (the scenarios share their maps).
	local catalog = 0
	for _, entry in ipairs(self.missions) do
		if entry.kpm:find("^/generated/missions/") then catalog = catalog + 1 end
	end
	self.autotest_last = count > 0 and math.min(catalog, first + count - 1) or catalog
	local bench = sys.get_config_string("viewer.tick_bench", "")
	if bench ~= "" then return bench_start(self, bench) end
	show(self, first)
end

-- Reports when the composition plan starts or stops being degraded: budget fallbacks of the
-- draw list or images left out for full backend families (presentation/images.lua).
local function note_composition(self, presentation)
	local degraded = presentation.degraded + presentation.overflow > 0
	if degraded ~= (self.composition_degraded or false) then
		self.composition_degraded = degraded
		report.line(degraded and ("composition degraded: %d budget fallbacks, %d images past the family capacity")
			:format(presentation.degraded, presentation.overflow) or "composition no longer degraded")
	end
end

-- Drains the scene's events (game/simulation/events.lua): sounds are counted, those at a point
-- of the view separately; a game's error notifications (stat_txt strings) and text lines join the
-- messages on screen. TODO: play the sounds through the native 8-channel audio manager (plan §7
-- phase 9 item 6) and show the messages in the game's interface (plan §7 phase 9).
local function drain_events(self)
	local view = view_rect(self)
	local now = socket.gettime()
	-- b, c: a sound's position, an error's string id (game/simulation/events.lua kinds).
	self.scene.events:drain(function(kind, _, _, _, b, c, _, text)
		if kind == events.SOUND then
			self.sounds = self.sounds + 1
			if view and b >= view.left and b < view.right and c >= view.top and c < view.bottom then
				self.sounds_in_view = self.sounds_in_view + 1
			end
		elseif kind == events.ERROR or kind == events.TEXT then
			local line = kind == events.ERROR and (strings.get(self.stat_txt, b) or "") or text
			table.insert(self.messages, { text = line, expires = now + MESSAGE_SECONDS })
			if #self.messages > MESSAGE_LINES then table.remove(self.messages, 1) end
			self.message_count = self.message_count + 1
		end
	end)
end

-- Runs n scene ticks with a presentation sync after each and logs their cost; the draw
-- list of the last one is collected for the composition check.
local function run_ticks(self, n, label)
	local t0, step_s, sync_s = socket.gettime(), 0, 0
	self.sounds, self.sounds_in_view = 0, 0
	for _ = 1, n do
		map_world.step(self.scene)
		local t1 = socket.gettime()
		self.presentation:sync(self.backend, nil, view_rect(self))
		drain_events(self)
		step_s, sync_s, t0 = step_s + t1 - t0, sync_s + socket.gettime() - t1, socket.gettime()
	end
	self.scene_images = {}
	self.presentation:sync(self.backend, self.scene_images, view_rect(self))
	note_composition(self, self.presentation)
	report.line(("ticks %s%s: %d ticks, simulation %.2f ms and presentation sync %.2f ms per tick, %d sounds (%d in view)")
		:format(self.missions[self.current].name, label, n, step_s * 1000 / n, sync_s * 1000 / n, self.sounds,
			self.sounds_in_view))
	self.wait = SETTLE_FRAMES
end

-- Puts the unit sprites of the view under the runtime draw effects (viewer/effect_scene.lua).
local function apply_effects(self)
	local w = self.scene.world
	local warp = self.presentation.frame_of(w:grp_of(image.WARP_TEXTURE), 0) ~= nil
	local n = effect_scene.apply(self.scene, { left = self.cam_x, top = self.cam_y, right = self.cam_x + self.world_w,
		bottom = self.cam_y + self.world_h }, warp)
	report.line(("effects %s: %d sprites, warp texture %s"):format(self.missions[self.current].name, n,
		warp and "loaded" or "not loaded"))
end

-- (Re)shows the browsed image at the centre of the view.
local function browser_show(self)
	local b = self.browser
	b:show(self.cam_x + math.floor(self.world_w / 2), self.cam_y + math.floor(self.world_h / 2))
	self.browser_presentation = images.new(b.world, self.grpmeta, self.frame_table, self.rows)
	self.browser_presentation:sync(self.backend, nil, view_rect(self))
end

-- Toggles the animation browser; the map scene pauses meanwhile.
local function toggle_browser(self)
	if self.browser then
		self.browser, self.browser_presentation = nil, nil
		self.presentation:sync(self.backend, nil, view_rect(self))
		return
	end
	local frames, grp = self.frame_table, self.grpmeta
	self.browser = browser.new({ dat = self.dat, grp = grp, iscript = self.iscript }, self.mission.width,
		self.mission.height, function(id)
			local g = grpmeta_data.image_grp(grp, self.dat.images, id)
			return self.presentation.frame_of(g, 0) ~= nil
		end)
	if not self.browser:showable(self.browser.image) then self.browser:next_image(1) end
	browser_show(self)
end

-- Autotest: shows image `id` in the browser and runs BROWSER_TICKS ticks.
local function browser_check(self, id)
	self.browser.image, self.browser.anim = id, 0
	browser_show(self)
	for _ = 1, BROWSER_TICKS do
		self.browser:step()
		self.browser_presentation:sync(self.backend, nil, view_rect(self))
	end
	self.scene_images = {}
	self.browser_presentation:sync(self.backend, self.scene_images, view_rect(self))
	self.wait = SETTLE_FRAMES
end

autotest_after = function(self, index)
	if self.browser then toggle_browser(self) end
	self.autotest_view = nil
	if index < self.autotest_last then return show(self, index + 1) end
	report.line(("autotest: %d missions, %d megatiles checked, %d mismatches; sprites: %d images (%d rotated), %d pixels, %d mismatches; composed views: %d; load failures: %d")
		:format(self.autotest_last - self.autotest_first + 1, self.total_checked, self.total_bad, self.sprite_images,
			self.sprite_rotated, self.sprite_pixels, self.sprite_bad, self.composed, self.load_failures))
	report.done()
end

local function autotest_step(self)
	-- Steps after a fill: 1 top-left and 2 bottom-right terrain checks (before the scene is
	-- drawn), 3 the mission's packs and scene, 4 the sprite and composition checks at the
	-- top-left, 5 the composition after AUTOTEST_TICKS ticks, 6 and 7 after the draw effects
	-- and EFFECT_TICKS[1] and [2] more ticks, then the next mission.
	if self.autotest_view == 3 then
		if not self.scene_ready then return end
	else
		self.wait = self.wait - 1
		if self.wait > 0 then return end
		if report.is_web or self.index_capture then
			if self.autotest_view == 4 then
				check_sprites(self)
				check_compose(self, "")
			elseif self.autotest_view == 5 then
				check_compose(self, "@" .. AUTOTEST_TICKS)
			elseif self.autotest_view == 8 then
				check_compose(self, "@image" .. self.browser.image)
			elseif self.autotest_view >= 6 then
				check_compose(self, "@fx" .. EFFECT_TICKS[self.autotest_view - 5])
			else
				check_view(self, self.autotest_view == 1 and "top-left" or "bottom-right")
			end
		end
	end
	if self.autotest_view == 1 then
		self.autotest_view = 2
		self.cam_x, self.cam_y = math.huge, math.huge
		clamp_camera(self)
		self.wait = SETTLE_FRAMES
	elseif self.autotest_view == 2 then
		self.autotest_view = 3
		load_packs(self)
	elseif self.autotest_view == 3 then
		self.autotest_view = 4
		self.cam_x, self.cam_y = 0, 0
		clamp_camera(self)
		-- The scene was planned for the bottom-right view; replan the same tick for this one.
		self.scene_images = {}
		self.presentation:sync(self.backend, self.scene_images, view_rect(self), true)
		self.wait = SETTLE_FRAMES
	elseif self.autotest_view == 4 then
		self.autotest_view = 5
		run_ticks(self, AUTOTEST_TICKS, "")
	elseif self.autotest_view == 5 then
		self.autotest_view = 6
		apply_effects(self)
		run_ticks(self, EFFECT_TICKS[1], "@fx")
	elseif self.autotest_view == 6 then
		self.autotest_view = 7
		run_ticks(self, EFFECT_TICKS[2] - EFFECT_TICKS[1], "@fx")
	elseif self.autotest_view == 7 and self.current == self.autotest_first then
		-- The animation browser on the first mission: BROWSER_CHECKS images spread over the ids.
		self.autotest_view = 8
		toggle_browser(self)
		self.browser_queue = {}
		local start = 0
		for _ = 1, BROWSER_CHECKS do
			self.browser.image = start
			if not self.browser:showable(start) then self.browser:next_image(1) end
			if self.browser.image < start then break end
			self.browser_queue[#self.browser_queue + 1] = self.browser.image
			start = self.browser.image + BROWSER_STRIDE
		end
		browser_check(self, table.remove(self.browser_queue, 1))
	elseif self.autotest_view == 8 and #self.browser_queue > 0 then
		browser_check(self, table.remove(self.browser_queue, 1))
	else
		autotest_after(self, self.current)
	end
end

-- Play mode (viewer/play_world.lua): the local player's fog over the map in the debug overlay,
-- a texture of one texel per tile updated after the game's steps.
local function update_fog(self)
	local m = self.mission
	if not (self.scene and self.scene.game) then return end
	local buf = buffer.create(m.width * m.height, { { name = hash("rgba"), type = buffer.VALUE_TYPE_UINT8, count = 4 } })
	play_world.fog_pixels(self.scene, buffer.get_stream(buf, hash("rgba")))
	local params = { type = graphics.TEXTURE_TYPE_2D, width = m.width, height = m.height,
		format = graphics.TEXTURE_FORMAT_RGBA }
	if self.fog_texture then
		resource.set_texture(FOG_PATH, params, buf)
	else
		self.fog_texture = resource.create_texture(FOG_PATH, params, buf)
	end
	msg.post("overlay#overlay", "kp_overlay", { mode = "texture", texture = FOG_PATH,
		map_w = m.width * terrain.TILE, map_h = m.height * terrain.TILE })
end

-- The map point under a screen point (the world fills the window from its bottom-left corner).
local function screen_to_map(self, x, y)
	return math.floor(self.cam_x + x / self.scale), math.floor(self.cam_y + self.world_h - y / self.scale)
end

-- Enter: a real game of the shown mission instead of the animated map scene, or back.
local function toggle_play(self)
	if not self.mission or self.browser then return end
	self.playing = not self.playing
	self.drag = nil
	if not self.playing and self.fog then
		self.fog = false
		msg.post("overlay#overlay", "kp_overlay", { mode = "off" })
	end
	if self.scene_ready then build_scene(self) end
end

local handle_input -- on_input's body (set below), which the play check calls too


-- viewer.screenshot = <path>: the window's frame as a PNG through native/kp_capture (desktop
-- engines built with the project's extensions); `suffix` goes before the extension.
local function screenshot(suffix)
	local path = sys.get_config_string("viewer.screenshot", "")
	local capture = rawget(_G, "kp_capture")
	if path == "" or not capture then return end
	path = path:gsub("%.png$", "") .. suffix .. ".png"
	local w, h = capture.save(path, sys.get_config_int("viewer.screenshot_bottom_up", 0) == 1,
		sys.get_config_int("viewer.screenshot_bgra", 0) == 1)
	report.line(("screenshot %s: %dx%d"):format(path, w, h))
end

-- The play check through the desktop input path (handle_input below): Enter, a drag over the
-- Marines, a right click; then the game runs and the result is logged.
local function play_check_step(self, dt)
	local pc = self.play_check
	local spec = pc.spec
	if not (self.scene_ready and self.scale) then return end
	local function to_screen(x, y)
		return (x - self.cam_x) * self.scale, (self.cam_y + self.world_h - y) * self.scale
	end
	if pc.stage == 1 then
		handle_input(self, hash("play"), { pressed = true })
		local b = spec.box
		self.cam_x = math.floor((b[1] + spec.target[1]) / 2 - self.world_w / 2)
		self.cam_y = math.floor((b[2] + b[4]) / 2 - self.world_h / 2)
		clamp_camera(self)
		pc.stage = 2
	elseif pc.stage == 2 then
		local b = spec.box
		local x0, y0 = to_screen(b[1], b[2])
		local x1, y1 = to_screen(b[3], b[4])
		handle_input(self, hash("touch"), { pressed = true, screen_x = x0, screen_y = y0 })
		handle_input(self, hash("touch"), { released = true, screen_x = x1, screen_y = y1 })
		local g = self.scene.game
		pc.selected = 0
		for k = 0, play_world.MAX_SELECTION - 1 do
			if g and g.local_selection[k] ~= 0 then pc.selected = pc.selected + 1 end
		end
		pc.stage = 3
	elseif pc.stage == 3 and self.scene.tick >= 2 then
		local x, y = to_screen(spec.target[1], spec.target[2])
		handle_input(self, hash("right_click"), { released = true, screen_x = x, screen_y = y })
		if sys.get_config_int("viewer.play_check_fog", 1) == 1 then handle_input(self, hash("fog"), { pressed = true }) end
		pc.stage = 4
	elseif pc.stage == 4 and (self.scene.failed or self.scene.tick >= spec.steps) then
		local g, sc = self.scene.game, self.scene
		local xs = {}
		for k = 0, play_world.MAX_SELECTION - 1 do
			local n = g and g.local_selection[k] or 0
			if n ~= 0 then xs[#xs + 1] = ("%d,%d"):format(g.u.x[n], g.u.y[n]) end
		end
		report.line(("play check %s: %d selected by the box, step %d, %s; selection at %s; steps %.2f ms mean, %.2f ms max; native core")
			:format(self.missions[self.current].name, pc.selected, sc.tick, sc.failed and ("stopped: " .. sc.failed) or "running",
				table.concat(xs, " "), (sc.step_ms or 0) / math.max(1, sc.tick), sc.step_max_ms or 0))
		pc.stage, pc.linger = 5, PLAY_CHECK_LINGER
	elseif pc.stage == 5 then
		-- viewer.screenshot = <path>: the window's frame as a PNG (native/kp_capture), once
		-- the final state has been drawn.
		if not pc.shot and pc.linger < PLAY_CHECK_LINGER - 1 then
			pc.shot = true
			screenshot("")
		end
		pc.linger = pc.linger - dt
		if pc.linger <= 0 then
			self.play_check = nil
			report.done()
		end
	end
end

function update(self, dt)
	if self.bench then return bench_step(self) end
	msg.post("@render:", "kp_stats")
	if self.fill_pending and self.proxies:loaded(self.ts.name) then
		self.fill_pending = false
		local m, name = self.mission, self.ts.name
		terrain.queue(hash("mission_" .. name), m.width, m.height, self.ids, msg.url(), self.fill_token)
		msg.post("mission_" .. name .. ":/terrain#terrain", terrain.FILL)
	end
	if self.pan.x ~= 0 or self.pan.y ~= 0 then
		self.cam_x = self.cam_x + self.pan.x * PAN_PER_FRAME
		self.cam_y = self.cam_y + self.pan.y * PAN_PER_FRAME
		clamp_camera(self)
	end
	if self.backend and self.presentation then
		-- The autotest keeps the scene at its creation state so the readbacks are deterministic.
		local fraction = 1
		if not self.autotest then
			local ticks
			if self.playing and not self.browser then
				ticks, fraction = self.scene:advance(socket.gettime())
			else
				ticks, fraction = self.clock:advance_wall(socket.gettime())
				for _ = 1, ticks do
					if self.browser then self.browser:step() else map_world.step(self.scene) end
				end
			end
			local view = view_rect(self)
			local presentation = active_presentation(self)
			drain_events(self)
			if ticks > 0 then
				presentation:sync(self.backend, nil, view)
			elseif presentation:needs_replan(view) then
				presentation:sync(self.backend, nil, view, true)
			end
			note_composition(self, presentation)
			if self.fog and self.playing and ticks > 0 then update_fog(self) end
		end
		local interp = self.backend:sync(fraction)
		msg.post("@render:", "kp_world_frame", { interp = interp })
	end
	-- Colour cycles run on real time (presentation/palette.lua); the autotest's readbacks
	-- check indices, so they keep cycling too.
	if self.screen_palette then
		local now = socket.gettime()
		if self.screen_palette:advance((now - self.palette_clock) * 1000, self.gray_saved ~= nil) then
			set_palette(self, self.screen_palette:rgb())
		end
		self.palette_clock = now
	end
	if self.autotest_view then autotest_step(self) end
	if self.play_check then play_check_step(self, dt) end
	-- viewer.screenshot_after = <seconds>: one screenshot of whatever the viewer shows then.
	if self.shot_after then
		self.shot_after = self.shot_after - dt
		if self.shot_after <= 0 then
			self.shot_after = nil
			screenshot("_after")
		end
	end
	if self.mission and self.win_h then
		msg.post("@render:", "draw_debug_text", {
			text = ("%d/%d %s  %dx%d %s  N/P mission, arrows/drag pan, M scale, W walk, R regions, B brightness %d, G gray, A browser")
				:format(self.current, #self.missions, self.missions[self.current].name, self.mission.width, self.mission.height,
					self.ts.name, self.screen_palette and self.screen_palette.brightness or palette.BRIGHTNESS_DEFAULT),
			position = vmath.vector3(8, self.win_h - 8, 0), color = vmath.vector4(1, 1, 1, 1),
		})
		if self.playing then
			local sc = self.scene
			local status = sc and sc.failed and ("stopped: " .. sc.failed)
				or ("step %d  left click/box select, right click order, F fog, Enter leaves"):format(sc and sc.tick or 0)
			msg.post("@render:", "draw_debug_text", { text = "PLAY " .. status, position = vmath.vector3(8, self.win_h - 48, 0),
				color = sc and sc.failed and vmath.vector4(1, 0.4, 0.4, 1) or vmath.vector4(0.6, 1, 0.6, 1) })
			local now, y = socket.gettime(), self.win_h - 68
			for k = #self.messages, 1, -1 do
				if self.messages[k].expires <= now then table.remove(self.messages, k) end
			end
			for _, m in ipairs(self.messages) do
				msg.post("@render:", "draw_debug_text", { text = m.text, position = vmath.vector3(8, y, 0),
					color = vmath.vector4(1, 1, 1, 1) })
				y = y - 20
			end
		end
		local b = self.browser
		if b then
			local g = grpmeta_data.image_grp(self.grpmeta, self.dat.images, b.image)
			msg.post("@render:", "draw_debug_text", {
				text = ("image %d %s  animation %d  direction %d  %s  [ ] image, ; ' animation, , . direction, space restart")
					:format(b.image, self.grpmeta.grps[g].path, b.anim, b.direction, b.fault or ""),
				position = vmath.vector3(8, self.win_h - 28, 0), color = vmath.vector4(1, 1, 0.5, 1),
			})
		end
	end
end

function on_message(self, message_id, message, sender)
	if message_id == MSG_STATS then
		local resized = self.world_w ~= message.world_w or self.world_h ~= message.world_h
		self.world_w, self.world_h, self.scale, self.win_h = message.world_w, message.world_h, message.scale, message.win_h
		if resized then clamp_camera(self) end
	elseif message_id == PROXY_UNLOADED then
		self.proxies:on_unloaded(self.proxy_names[sender.fragment])
	elseif message_id == PROXY_LOADED then
		if self.proxies:on_loaded(self.proxy_names[sender.fragment]) then self.fill_pending = true end
	elseif message_id == hash("kp_minimap_jump") then
		self.cam_x, self.cam_y = message.x - self.world_w / 2, message.y - self.world_h / 2
		clamp_camera(self)
	elseif message_id == terrain.FILLED and message.token == self.fill_token then
		local brightness = self.screen_palette and self.screen_palette.brightness
		self.screen_palette = palette.new(self.ts.rgb, self.ts.cycles)
		if brightness then self.screen_palette:set_brightness(brightness) end
		self.palette_clock, self.gray_saved = socket.gettime(), nil
		set_palette(self, self.screen_palette:rgb())
		local entry = self.missions[self.current]
		msg.post("minimap#minimap", "kp_minimap", { path = "/generated/missions/" .. entry.map .. "_minimap.png",
			map_w = self.mission.width * terrain.TILE, map_h = self.mission.height * terrain.TILE })
		msg.post("overlay#overlay", "kp_overlay", { mode = self.overlay, mission = entry.map,
			map_w = self.mission.width * terrain.TILE, map_h = self.mission.height * terrain.TILE })
		clamp_camera(self)
		if not self.autotest then load_packs(self) end
		report.line(("mission %s: %dx%d %s, load %.1f ms, import %.1f ms, fill %.1f ms"):format(entry.name,
			self.mission.width, self.mission.height, self.ts.name, self.timing.load_ms, self.timing.import_ms, message.ms))
		if self.autotest then
			self.autotest_view, self.wait = 1, SETTLE_FRAMES
		end
	end
end

handle_input = function(self, action_id, action)
	if action_id == hash("escape") and action.released and not report.is_web then
		sys.exit(0)
	elseif action_id == hash("next") and action.pressed then
		next_mission(self, 1)
	elseif action_id == hash("previous") and action.pressed then
		next_mission(self, -1)
	elseif (action_id == hash("overlay_walk") or action_id == hash("overlay_regions")) and action.pressed then
		local mode = action_id == hash("overlay_walk") and "walk" or "regions"
		self.overlay = self.overlay == mode and "off" or mode
		msg.post("overlay#overlay", "kp_overlay", { mode = self.overlay, mission = self.missions[self.current].map,
			map_w = self.mission.width * terrain.TILE, map_h = self.mission.height * terrain.TILE })
	elseif action_id == hash("browser") and action.pressed and self.backend then
		toggle_browser(self)
	elseif self.browser and self.backend and action.pressed and BROWSER_KEYS[action_id] then
		BROWSER_KEYS[action_id](self.browser)
		browser_show(self)
	elseif action_id == hash("brightness") and action.pressed and self.screen_palette then
		local b = self.screen_palette.brightness + BRIGHTNESS_STEP
		self.screen_palette:set_brightness(b > palette.BRIGHTNESS_MAX and palette.BRIGHTNESS_MIN or b)
		set_palette(self, self.screen_palette:rgb())
	elseif action_id == hash("grayscale") and action.pressed and self.screen_palette then
		-- Grayscale as the paused game shows it (0x4ccf40); cycling stops meanwhile.
		if self.gray_saved then
			self.screen_palette:fade_to(self.gray_saved, 0)
			self.gray_saved = nil
		else
			self.gray_saved = self.screen_palette:current()
			self.screen_palette:grayscale()
		end
		set_palette(self, self.screen_palette:rgb())
	elseif action_id == hash("scale_mode") and action.pressed then
		self.scale_mode = self.scale_mode % #SCALE_MODES + 1
		msg.post("@render:", "kp_scale_mode", { mode = SCALE_MODES[self.scale_mode] })
	elseif action_id == hash("left") or action_id == hash("right") then
		self.pan.x = action.released and 0 or (action_id == hash("left") and -1 or 1)
	elseif action_id == hash("up") or action_id == hash("down") then
		self.pan.y = action.released and 0 or (action_id == hash("up") and -1 or 1)
	elseif action_id == hash("play") and action.pressed then
		toggle_play(self)
	elseif action_id == hash("fog") and action.pressed and self.playing then
		self.fog = not self.fog
		if self.fog then update_fog(self) else msg.post("overlay#overlay", "kp_overlay", { mode = "off" }) end
	elseif self.playing and action_id == hash("touch") and self.scale then
		-- Play mode: a click selects the unit under it, a drag selects the units in its box.
		if action.pressed then
			self.drag = { x = action.screen_x, y = action.screen_y }
		elseif action.released and self.drag then
			local d = self.drag
			self.drag = nil
			local x0, y0 = screen_to_map(self, d.x, d.y)
			local x1, y1 = screen_to_map(self, action.screen_x, action.screen_y)
			if math.abs(action.screen_x - d.x) <= CLICK_SLOP and math.abs(action.screen_y - d.y) <= CLICK_SLOP then
				play_world.select(self.scene, x1, y1, x1, y1)
			else
				play_world.select(self.scene, math.min(x0, x1), math.min(y0, y1), math.max(x0, x1), math.max(y0, y1))
			end
		end
	elseif self.playing and action_id == hash("right_click") and action.released and self.scale then
		play_world.right_click(self.scene, screen_to_map(self, action.screen_x, action.screen_y))
	elseif action_id == hash("touch") and not action.pressed and self.scale then
		self.cam_x = self.cam_x - action.screen_dx / self.scale
		self.cam_y = self.cam_y + action.screen_dy / self.scale
		clamp_camera(self)
	end
end

function on_input(self, action_id, action)
	handle_input(self, action_id, action)
end
