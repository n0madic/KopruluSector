-- Viewer minimap (plan §7 phase 1 item 7): the converter's <mission>_minimap.png in the
-- bottom-left corner with the camera rectangle. Messages:
--   kp_minimap { path=, map_w=, map_h= }   map size in pixels
--   kp_minimap_view { x=, y=, w=, h= }     view rectangle in map pixels (y down)
--   kp_minimap_fog { version=, w=, h=, offset=, total=, data= }  a chunk of the minimap composed with its fog
--                                          (presentation/minimap_chunks.lua; this Lua context has its own modules)
--   kp_select_box { x0=, y0=, x1=, y1= }   the play mode's selection box in GUI coordinates (y up); empty: hide it
-- A click or drag on the minimap posts kp_minimap_jump { x=, y= } (map pixels) to the sender
-- of kp_minimap.
local SIZE = 128 -- on-screen box, pixels
local MARGIN = 8
local LINE = 1

local MSG_LOAD = hash("kp_minimap")
local MSG_VIEW = hash("kp_minimap_view")
local MSG_FOG = hash("kp_minimap_fog")
local MSG_SELECT_BOX = hash("kp_select_box")
local chunks = require("presentation.minimap_chunks")

local function box(x, y, w, h, color)
	local n = gui.new_box_node(vmath.vector3(x, y, 0), vmath.vector3(w, h, 0))
	gui.set_pivot(n, gui.PIVOT_SW)
	gui.set_color(n, color)
	return n
end

function init(self)
	self.image = box(MARGIN, MARGIN, SIZE, SIZE, vmath.vector4(1, 1, 1, 1))
	gui.set_enabled(self.image, false)
	local c = vmath.vector4(1, 1, 1, 1)
	self.frame = { box(0, 0, 1, LINE, c), box(0, 0, 1, LINE, c), box(0, 0, LINE, 1, c), box(0, 0, LINE, 1, c) }
	for _, n in ipairs(self.frame) do gui.set_enabled(n, false) end
	local green = vmath.vector4(0.1, 0.95, 0.1, 1) -- the original draws its selection box green
	self.select = { box(0, 0, 1, LINE, green), box(0, 0, 1, LINE, green), box(0, 0, LINE, 1, green), box(0, 0, LINE, 1, green) }
	for _, n in ipairs(self.select) do gui.set_enabled(n, false) end
	msg.post(".", "acquire_input_focus")
end

local function layout(self)
	-- Keep the aspect ratio of the map inside the SIZE x SIZE box.
	local s = SIZE / math.max(self.map_w, self.map_h)
	self.scale = s
	self.draw_w, self.draw_h = self.map_w * s, self.map_h * s
	gui.set_size(self.image, vmath.vector3(self.draw_w, self.draw_h, 0))
end

local function frame(self, x, y, w, h)
	local s, top = self.scale, MARGIN + self.draw_h
	local x0, y0 = MARGIN + x * s, top - (y + h) * s
	local fw, fh = math.min(w, self.map_w - x) * s, math.min(h, self.map_h - y) * s
	local f = self.frame
	gui.set_position(f[1], vmath.vector3(x0, y0, 0)); gui.set_size(f[1], vmath.vector3(fw, LINE, 0))
	gui.set_position(f[2], vmath.vector3(x0, y0 + fh - LINE, 0)); gui.set_size(f[2], vmath.vector3(fw, LINE, 0))
	gui.set_position(f[3], vmath.vector3(x0, y0, 0)); gui.set_size(f[3], vmath.vector3(LINE, fh, 0))
	gui.set_position(f[4], vmath.vector3(x0 + fw - LINE, y0, 0)); gui.set_size(f[4], vmath.vector3(LINE, fh, 0))
	for _, n in ipairs(f) do gui.set_enabled(n, true) end
end

-- gui.set_texture_data takes the rows bottom first; the composed image has them top first.
local function flip_rows(rgb, w, h)
	local stride, rows = w * 3, {}
	for y = 0, h - 1 do rows[h - y] = rgb:sub(y * stride + 1, (y + 1) * stride) end
	return table.concat(rows)
end

-- The selection box: four lines over the rectangle between two window points.
local function select_box(self, message)
	local f = self.select
	if not message.x0 then
		for _, n in ipairs(f) do gui.set_enabled(n, false) end
		return
	end
	local x, y = math.min(message.x0, message.x1), math.min(message.y0, message.y1)
	local w, h = math.abs(message.x1 - message.x0), math.abs(message.y1 - message.y0)
	gui.set_position(f[1], vmath.vector3(x, y, 0)); gui.set_size(f[1], vmath.vector3(w, LINE, 0))
	gui.set_position(f[2], vmath.vector3(x, y + h - LINE, 0)); gui.set_size(f[2], vmath.vector3(w, LINE, 0))
	gui.set_position(f[3], vmath.vector3(x, y, 0)); gui.set_size(f[3], vmath.vector3(LINE, h, 0))
	gui.set_position(f[4], vmath.vector3(x + w - LINE, y, 0)); gui.set_size(f[4], vmath.vector3(LINE, h, 0))
	for _, n in ipairs(f) do gui.set_enabled(n, true) end
end

function on_message(self, message_id, message, sender)
	if message_id == MSG_LOAD then
		local img = image.load(sys.load_resource(message.path))
		if self.texture then gui.delete_texture(self.texture) end
		self.texture = hash(message.path)
		local kind = img.type == image.TYPE_RGBA and "rgba" or img.type == image.TYPE_RGB and "rgb" or "l"
		gui.new_texture(self.texture, img.width, img.height, kind, img.buffer)
		gui.set_texture(self.image, self.texture)
		gui.set_enabled(self.image, true)
		self.map_w, self.map_h, self.owner = message.map_w, message.map_h, sender
		layout(self)
	elseif message_id == MSG_FOG and self.texture then
		self.fog_parts = self.fog_parts or {}
		local img = chunks.assemble(self.fog_parts, message)
		if img then gui.set_texture_data(self.texture, img.w, img.h, "rgb", flip_rows(img.rgb, img.w, img.h)) end
	elseif message_id == MSG_SELECT_BOX then
		select_box(self, message)
	elseif message_id == MSG_VIEW and self.map_w then
		frame(self, message.x, message.y, message.w, message.h)
	end
end

function on_input(self, action_id, action)
	if action_id ~= hash("touch") or not self.map_w or action.released then return false end
	if not gui.pick_node(self.image, action.x, action.y) then return false end
	local s = self.scale
	msg.post(self.owner, "kp_minimap_jump", { x = (action.x - MARGIN) / s, y = (MARGIN + self.draw_h - action.y) / s })
	return true
end
