-- Resource pack check (ADR 0004), enabled by `[viewer] packcheck = 1`. For every pack
-- collection factory of /generated/packs/packs.go: residency probe, collectionfactory.load,
-- texture sizes of the pack's atlases (each must be one page <= 4096^2, ADR 0003), create,
-- delete, unload, probe again. Then all packs at once, each pack once more (warm), then
-- every mission assets proxy of /generated/missions/mission_assets.go (async_load, unload).
-- Atlas names come from grpmeta.kpd. Results are "SPIKE ..." lines; the run ends with "SPIKE done".
local loader = require("game.data.loader")
local grpmeta = require("game.data.grpmeta")
local report = require("spikes.common.report")

local MAX_PAGE = 4096
local SETTLE_FRAMES = 2
local PORTRAIT_PACKS = { terran = { "portraits_t", "portraits_u" }, protoss = { "portraits_p" },
	zerg = { "portraits_z" }, neutral = { "portraits_n" } }
local PROXY_LOADED = hash("proxy_loaded")
local PROXY_UNLOADED = hash("proxy_unloaded")

local function now_ms()
	return socket.gettime() * 1000
end

-- Packs in grpmeta order with their atlas names (pack atlases, mask atlases, portraits).
local function pack_list()
	local g = grpmeta.parse(loader.read("/generated/data/grpmeta.kpd"), "grpmeta.kpd")
	local packs, by_name = {}, {}
	for _, a in ipairs(g.atlases) do
		local p = by_name[a.pack]
		if not p then
			p = { name = a.pack, atlases = {} }
			by_name[a.pack] = p
			packs[#packs + 1] = p
		end
		p.atlases[#p.atlases + 1] = a.name
		if a.mask then p.atlases[#p.atlases + 1] = a.name .. "_mask" end
	end
	-- Sound-only packs are not in grpmeta; every stock pack has GRPs.
	for _, p in ipairs(packs) do
		for _, name in ipairs(PORTRAIT_PACKS[p.name] or {}) do p.atlases[#p.atlases + 1] = name end
	end
	return packs
end

local function missions()
	local out = {}
	for line in sys.load_resource("/generated/missions/index.txt"):gmatch("[^\n]+") do
		out[#out + 1] = line:match("^(%S+)"):gsub("/", "_")
	end
	return out
end

-- Atlas residency: resource.get_atlas raises for a texture set that is not loaded.
local function probe(pack)
	local parts, resident, bad = {}, 0, 0
	for _, name in ipairs(pack.atlases) do
		local ok, a = pcall(resource.get_atlas, "/generated/atlases/" .. name .. ".a.texturesetc")
		if ok then
			local info = resource.get_texture_info(a.texture)
			resident = resident + 1
			if info.width > MAX_PAGE or info.height > MAX_PAGE or (info.depth or 1) > 1 then bad = bad + 1 end
			parts[#parts + 1] = ("%s=%dx%dx%d"):format(name, info.width, info.height, info.depth or 1)
		else
			parts[#parts + 1] = name .. "=absent"
		end
	end
	return resident, bad, table.concat(parts, " ")
end

local function wait_frames(n)
	local left = n
	return function()
		left = left - 1
		return left <= 0
	end
end

local function pack_steps(self, pack)
	local url = "packs#" .. pack.name
	local t0, ids
	return {
		function()
			local resident = probe(pack)
			if resident > 0 then self.failures = self.failures + 1 end
			self.waiting = true
			t0 = now_ms()
			collectionfactory.load(url, function(_, _, ok)
				local ms = now_ms() - t0
				local loaded, bad, sizes = probe(pack)
				local good = ok and loaded == #pack.atlases and bad == 0
				if not good then self.failures = self.failures + 1 end
				report.line(("pack %s: load %s %.1f ms, %s%s"):format(pack.name, ok and "ok" or "FAILED", ms, sizes,
					bad > 0 and " (OVER 4096)" or ""))
				self.waiting = false
			end)
			return true
		end,
		function() return not self.waiting end,
		function()
			local t = now_ms()
			ids = collectionfactory.create(url)
			local count = 0
			for _ in pairs(ids) do count = count + 1 end
			-- The atlas holders only keep the atlases referenced; never draw them.
			if ids[hash("/atlases")] then msg.post(ids[hash("/atlases")], "disable") end
			report.line(("pack %s: create %.2f ms, %d instances"):format(pack.name, now_ms() - t, count))
			return true
		end,
		wait_frames(SETTLE_FRAMES),
		function()
			for _, id in pairs(ids) do go.delete(id) end
			return true
		end,
		wait_frames(SETTLE_FRAMES),
		function()
			collectionfactory.unload(url)
			return true
		end,
		wait_frames(SETTLE_FRAMES),
		function()
			local resident, _, sizes = probe(pack)
			if resident > 0 then self.failures = self.failures + 1 end
			report.line(("pack %s: after unload %s"):format(pack.name, resident == 0 and "absent" or ("RESIDENT " .. sizes)))
			return true
		end,
	}
end

local function all_packs_steps(self, packs)
	local t0
	return {
		function()
			self.pending = #packs
			t0 = now_ms()
			for _, p in ipairs(packs) do
				collectionfactory.load("packs#" .. p.name, function(_, _, ok)
					if not ok then
						self.failures = self.failures + 1
						report.line(("all packs: %s FAILED"):format(p.name))
					end
					self.pending = self.pending - 1
				end)
			end
			return true
		end,
		function()
			if self.pending > 0 then return false end
			report.line(("all %d packs: load %.1f ms"):format(#packs, now_ms() - t0))
			for _, p in ipairs(packs) do collectionfactory.unload("packs#" .. p.name) end
			return true
		end,
		wait_frames(SETTLE_FRAMES),
	}
end

-- Second load of one pack (warm file cache, materials already created).
local function warm_steps(self, pack)
	local url = "packs#" .. pack.name
	return {
		function()
			self.waiting = true
			local t0 = now_ms()
			collectionfactory.load(url, function(_, _, ok)
				if not ok then self.failures = self.failures + 1 end
				report.line(("pack %s: second load %s %.1f ms"):format(pack.name, ok and "ok" or "FAILED", now_ms() - t0))
				self.waiting = false
			end)
			return true
		end,
		function() return not self.waiting end,
		function()
			collectionfactory.unload(url)
			return true
		end,
		wait_frames(SETTLE_FRAMES),
	}
end

local function mission_steps(self, list)
	local steps = {}
	for _, name in ipairs(list) do
		steps[#steps + 1] = function()
			self.proxy, self.proxy_state, self.t0 = name, "loading", now_ms()
			msg.post("mission_assets#" .. name, "async_load")
			return true
		end
		steps[#steps + 1] = function() return self.proxy_state == "loaded" end
		steps[#steps + 1] = function()
			self.proxy_state = "unloading"
			msg.post("mission_assets#" .. name, "unload")
			return true
		end
		steps[#steps + 1] = function() return self.proxy_state == "unloaded" end
	end
	return steps
end

function init(self)
	if sys.get_config_int("viewer.packcheck", 0) ~= 1 then return end
	self.failures, self.missions = 0, 0
	local packs = pack_list()
	local list = missions()
	self.steps = {}
	local function add(steps)
		for _, s in ipairs(steps) do self.steps[#self.steps + 1] = s end
	end
	for _, p in ipairs(packs) do add(pack_steps(self, p)) end
	add(all_packs_steps(self, packs))
	for _, p in ipairs(packs) do add(warm_steps(self, p)) end
	add(mission_steps(self, list))
	add({ function()
		report.line(("packcheck: %d packs, %d mission assets, %d failures"):format(#packs, self.missions, self.failures))
		report.done()
		return true
	end })
	self.step = 1
end

function update(self)
	while self.steps and self.step <= #self.steps do
		if not self.steps[self.step]() then return end
		self.step = self.step + 1
	end
end

function on_message(self, message_id, message, sender)
	if message_id == PROXY_LOADED then
		self.missions = self.missions + 1
		report.line(("mission assets %s: load %.1f ms"):format(self.proxy, now_ms() - self.t0))
		self.proxy_state, self.t0 = "loaded", now_ms()
	elseif message_id == PROXY_UNLOADED then
		report.line(("mission assets %s: unload %.1f ms"):format(self.proxy, now_ms() - self.t0))
		self.proxy_state = "unloaded"
	end
end
