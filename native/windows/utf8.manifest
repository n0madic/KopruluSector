<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Every executable's process runs in the UTF-8 code page (Windows 10 1903 and later; earlier versions ignore it):
     the C library's paths and the A functions take the UTF-8 the core, SDL and the profile keep (CMakeLists.txt). -->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
