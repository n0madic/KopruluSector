-- Spike 07: indexed GRP atlases (all Terran unit GRPs) in single-texture and paged form.
-- Reports texture geometry per variant and draws frame 0 of a few GRPs from every variant
-- so an external capture (check_capture.py) can compare drawn indices with the GRP data.
local report = require("spikes.common.report")

local GENERATED = "/generated/spikes/07-atlas/"
-- Rows drawn: factory id -> atlases it samples (first one provides geometry/UVs).
local ROWS = {
	{ "la_crop", { "la_crop" } },
	{ "index_crop", { "index_crop" } },
	{ "index_mask_crop", { "index_crop", "mask_crop" } },
	{ "index_mask_crop_paged1024", { "index_crop_paged1024", "mask_crop_paged1024" } },
	{ "index_canvas_trim8_paged2048", { "index_canvas_trim8_paged2048" } },
}
local SHOWN = { "terran_marine", "terran_scv", "terran_firebat", "terran_ghost", "terran_goliath",
	"terran_phoenix", "terran_medic", "terran_tank" }
local ROW_HEIGHT, COLUMN_WIDTH = 92, 72
local HOLD_FRAMES = 240 -- keep the picture still for an external capture

local function webgl_version()
	if not report.is_web then return "n/a" end
	return html5.run("(function(){var c=document.getElementById('canvas');"
		.. "return c.getContext('webgl2')?'webgl2':(c.getContext('webgl')?'webgl1':'none')})()")
end

local function describe_atlas(variant)
	local path = GENERATED .. "terran_" .. variant .. ".a.texturesetc"
	local t0 = socket.gettime()
	local ok, atlas = pcall(resource.get_atlas, path)
	if not ok then
		report.line(("atlas variant=%s error=%s"):format(variant, tostring(atlas)))
		return nil
	end
	local info = resource.get_texture_info(atlas.texture)
	report.line(("atlas variant=%s width=%d height=%d depth=%d pages=%s type=%s animations=%d geometries=%d get_atlas_ms=%.2f")
		:format(variant, info.width, info.height, info.depth or -1, tostring(info.page_count), tostring(info.type),
			#atlas.animations, #atlas.geometries, (socket.gettime() - t0) * 1000))
	return atlas
end

function init(self)
	local sys_info = sys.get_sys_info()
	report.line(("system=%s engine=%s webgl=%s"):format(sys_info.system_name, sys.get_engine_info().version, webgl_version()))
	local described = {}
	for row, spec in ipairs(ROWS) do
		local variant, atlases = spec[1], spec[2]
		for _, name in ipairs(atlases) do
			described[name] = described[name] or describe_atlas(name)
		end
		local atlas = described[atlases[1]]
		if atlases[2] then
			-- Index and mask atlases must pack identically: the sprite takes UVs from the first.
			local other, same = described[atlases[2]], true
			for i, g in ipairs(atlas.geometries) do
				local h = other.geometries[i]
				for k, v in ipairs(g.uvs) do
					if h.uvs[k] ~= v then same = false end
				end
			end
			report.line(("layout_match %s %s %s"):format(atlases[1], atlases[2], tostring(same)))
		end
		if atlas then
			local index = {}
			for i, a in ipairs(atlas.animations) do index[a.id] = i end
			for col, id in ipairs(SHOWN) do
				local x, y = col * COLUMN_WIDTH, 480 - row * ROW_HEIGHT + 50
				local a = atlas.animations[index[id]]
				-- Sprites are centered: odd sizes need a half-pixel center so that the frame's
				-- top-left lands on a whole pixel (otherwise nearest sampling shifts a column).
				local center = vmath.vector3(x + (a.width % 2) * 0.5, y + (a.height % 2) * 0.5, 0)
				local ok, go_id = pcall(factory.create, "#" .. variant, center)
				if ok then
					sprite.play_flipbook(msg.url(nil, go_id, "sprite"), id)
					report.line(("place variant=%s id=%s x=%d y=%d size=%dx%d")
						:format(variant, id, x, y, a.width, a.height))
				else
					report.line(("place variant=%s id=%s error=%s"):format(variant, id, tostring(go_id)))
				end
			end
		end
	end
	self.frames = 0
end

function update(self, dt)
	self.frames = self.frames + 1
	if self.frames == 30 then
		report.line("capture")
	elseif self.frames == 30 + HOLD_FRAMES then
		report.done()
	end
end
