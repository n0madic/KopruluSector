-- Reports where the anchored panels end up after a resize.
function on_message(self, message_id, message, sender)
	if message_id == hash("query") then
		local function rect(id)
			local node = gui.get_node(id)
			local p = gui.get_screen_position(node)
			local s = gui.get_size(node)
			return { x = p.x, y = p.y, w = s.x, h = s.y }
		end
		msg.post(sender, "gui_rects", { panel = rect("panel"), corner = rect("corner") })
	end
end
