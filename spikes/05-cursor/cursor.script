-- Spike 5: exact frame selection in sprite_go via flipbook + cursor.
-- Frame k of every flipbook is a solid block of index (k % 255) + 1. Each formula maps
-- frame k to a cursor value; on HTML5 the index target is read back and every sprite's
-- pixel compared with the expected frame. Other platforms report counts only.
local lookup = require("presentation.lookup_textures")
local report = require("spikes.common.report")
local readback = require("spikes.common.readback")

local COUNTS = { 17, 68, 229, 391 }
local FORMULAS = {
	{ name = "(k + 0.5) / n", f = function(k, n) return (k + 0.5) / n end },
	{ name = "k / n", f = function(k, n) return k / n end },
	{ name = "(k + 1) / n - 1e-6", f = function(k, n) return (k + 1) / n - 1e-6 end },
	{ name = "k / (n - 1)", f = function(k, n) return n > 1 and k / (n - 1) or 0 end },
}
local STEP, PER_ROW = 6, 100

function init(self)
	local palette = {}
	for i = 0, 255 do palette[#palette + 1] = string.char(i, i, i) end
	lookup.palette(table.concat(palette))
	msg.post("@render:", "kp_textures", {
		remap = lookup.remap("/kp/remap.texturec", { lookup.identity_row() }),
	})
	msg.post("@render:", "kp_scale_mode", { mode = "integer", visible_height = 480 })
	self.sprites = {}
	local i = 0
	for _, n in ipairs(COUNTS) do
		for k = 0, n - 1 do
			local cx, cy = 4 + (i % PER_ROW) * STEP, 4 + math.floor(i / PER_ROW) * STEP
			local id = factory.create("#factory", vmath.vector3(cx, cy, 0))
			local url = msg.url(nil, id, "sprite")
			sprite.play_flipbook(url, "n" .. n)
			go.set(url, "playback_rate", 0)
			self.sprites[#self.sprites + 1] = { url = url, k = k, n = n, x = cx - 1, y = cy - 1 }
			i = i + 1
		end
	end
	self.formula, self.frame = 0, 0
	report.line(("platform %s, %d sprites"):format(sys.get_sys_info().system_name, #self.sprites))
end

local function apply(self)
	local f = FORMULAS[self.formula].f
	for _, s in ipairs(self.sprites) do go.set(s.url, "cursor", f(s.k, s.n)) end
end

local function check(self)
	local bad, first = 0, nil
	for _, s in ipairs(self.sprites) do
		local px = readback.red(1, s.x, s.y, 1, 1)
		local want = (s.k % 255) + 1
		local got = px and px:byte(1)
		if got ~= want then
			bad = bad + 1
			first = first or ("n=%d k=%d got %s"):format(s.n, s.k, tostring(got))
		end
	end
	return bad, first
end

function update(self)
	self.frame = self.frame + 1
	if self.frame % 5 ~= 0 then return end
	if self.formula > 0 then
		if report.is_web then
			local bad, first = check(self)
			report.line(("cursor = %s: %d of %d sprites show the wrong frame%s"):format(
				FORMULAS[self.formula].name, bad, #self.sprites, first and (" (first: " .. first .. ")") or ""))
		else
			report.line(("cursor = %s applied (no readback on this platform)"):format(FORMULAS[self.formula].name))
		end
	end
	self.formula = self.formula + 1
	if self.formula > #FORMULAS then
		self.formula = math.huge
		return report.done()
	end
	apply(self)
end
