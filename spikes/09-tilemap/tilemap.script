-- Spike 09: tilemap template fill, template bounds, palette cycling and proxy load times.
local report = require("spikes.common.report")

local TEMPLATE_PX = 256 * 32
local FRAMES_MEASURE = 120

local function wait_frames(n)
	local left = n
	return function()
		left = left - 1
		return left <= 0
	end
end

local function proxy_steps(self, proxy, maps, opts)
	local url = msg.url("#" .. proxy)
	local terrain = msg.url(proxy, "/terrain", "script")
	local steps = {
		function()
			self.t0 = socket.gettime()
			self.waiting = true
			msg.post(url, "async_load")
			return true
		end,
		function() return not self.waiting end,
		function() msg.post(url, "enable"); return true end,
		wait_frames(2),
	}
	local function add(f) steps[#steps + 1] = f end
	for _, map in ipairs(maps) do
		add(function() self.waiting = true; msg.post(terrain, "fill", { map = map }); return true end)
		add(function() return not self.waiting end)
	end
	if opts.capture then
		-- Top-left corner of the map (template row 256 is map row 0).
		add(function() msg.post("@render:", "set_view", { x = 0, y = TEMPLATE_PX - 480, zoom = 1 }); return true end)
		add(wait_frames(10))
		add(function() report.line("capture"); return true end)
		add(wait_frames(300))
	end
	if opts.cycle then
		add(function() self.waiting = true; msg.post(terrain, "cycle", { frames = opts.cycle }); return true end)
		add(function() return not self.waiting end)
	end
	if opts.fps then
		for _, zoom in ipairs({ 1, 480 / TEMPLATE_PX }) do
			add(function()
				msg.post("@render:", "set_view", { x = 0, y = 0, zoom = zoom })
				self.frame_count, self.frame_time = 0, 0
				return true
			end)
			add(wait_frames(5))
			add(function()
				self.frame_count = self.frame_count + 1
				if self.frame_count >= FRAMES_MEASURE then
					report.line(("frames proxy=%s zoom=%.4f avg_dt_ms=%.2f"):format(proxy, zoom,
						self.frame_time * 1000 / self.frame_count))
					return true
				end
				return false
			end)
		end
	end
	add(function()
		msg.post(url, "disable"); msg.post(url, "final")
		self.t0 = socket.gettime()
		self.waiting = true
		msg.post(url, "unload")
		return true
	end)
	add(function() return not self.waiting end)
	return steps
end

function init(self)
	report.line(("system=%s engine=%s lua=%s"):format(sys.get_sys_info().system_name,
		sys.get_engine_info().version, jit and jit.version or _VERSION))
	self.steps = {}
	local function add_all(list) for _, s in ipairs(list) do self.steps[#self.steps + 1] = s end end
	add_all(proxy_steps(self, "mission_desert", { "desert_256" }, { capture = true, cycle = 480, fps = true }))
	add_all(proxy_steps(self, "mission_desert", { "desert_terran05a" }, {}))
	add_all(proxy_steps(self, "mission_install", { "install_terran04", "install_64" }, {}))
	add_all(proxy_steps(self, "mission_desert_full", { "desert_terran05a" }, {}))
	self.step = 1
	self.frame_time = 0
end

function update(self, dt)
	if self.finished then return end
	self.frame_time = (self.frame_time or 0) + dt
	local step = self.steps[self.step]
	if not step then
		self.finished = true
		report.done()
		return
	end
	if step() then self.step = self.step + 1 end
end

function on_message(self, message_id, message, sender)
	if message_id == hash("proxy_loaded") or message_id == hash("proxy_unloaded") then
		report.line(("%s ms=%.1f"):format(message_id == hash("proxy_loaded") and "proxy_loaded" or "proxy_unloaded",
			(socket.gettime() - self.t0) * 1000))
		self.waiting = nil
	elseif message_id == hash("filled") or message_id == hash("cycled") then
		self.waiting = nil
	end
end
