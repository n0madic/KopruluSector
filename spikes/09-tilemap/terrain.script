-- Terrain of one tileset template collection (loaded through a proxy, plan §2.2).
-- fill {map}: fills the 256x256 template from a .kpm MTXM via the tileset CV5 table.
-- cycle {frames}: runs the stock simple palette cycles (whole palette, plan phase 0 item 9).
local loader = require("game.data.loader")
local report = require("spikes.common.report")

go.property("tileset", hash(""))

local TEMPLATE = 256
local GENERATED = "/generated/spikes/09-tilemap/"
local DRIVER_TICKS_PER_FRAME = 1 -- cycle driver cadence is not established by research; one call per frame here

local function u16(s, i) -- i is 0-based
	local a, b = s:byte(i + 1, i + 2)
	return a + b * 256
end

local upload_palette

local function load_tileset(self, name)
	local t0 = socket.gettime()
	local c = loader.load(GENERATED .. name .. ".kpd")
	local cv5m = c:section("CV5M")
	local megatile = {}
	for i = 0, #cv5m / 2 - 1 do megatile[i] = u16(cv5m, i * 2) end
	self.megatile = megatile
	local wpe = c:section("WPE ")
	local colors = {}
	for i = 0, 255 do
		local r, g, b = wpe:byte(i * 4 + 1, i * 4 + 3)
		colors[i] = { r, g, b }
	end
	self.colors = colors
	local cycl = c:section("CYCL")
	local count, speed = cycl:byte(1, 2)
	self.cycles = {}
	for i = 0, count - 1 do
		local low, high = cycl:byte(3 + i * 2, 4 + i * 2)
		self.cycles[#self.cycles + 1] = { low = low, high = high, speed = speed, counter = speed }
	end
	self.palette_path = "/spike09/palette_" .. name .. ".texturec"
	self.palette_buffer = buffer.create(256, { { name = hash("rgba"), type = buffer.VALUE_TYPE_UINT8, count = 4 } })
	self.palette_stream = buffer.get_stream(self.palette_buffer, hash("rgba"))
	self.palette_header = { type = graphics.TEXTURE_TYPE_2D, width = 256, height = 1,
		format = graphics.TEXTURE_FORMAT_RGBA, num_mip_maps = 1 }
	upload_palette(self, true)
	report.line(("tileset name=%s groups=%d cycles=%d load_ms=%.2f"):format(name, #cv5m / 32, count,
		(socket.gettime() - t0) * 1000))
end

function upload_palette(self, create)
	local s = self.palette_stream
	for i = 0, 255 do
		local c = self.colors[i]
		s[i * 4 + 1], s[i * 4 + 2], s[i * 4 + 3], s[i * 4 + 4] = c[1], c[2], c[3], 255
	end
	if create then
		resource.create_texture(self.palette_path, self.palette_header, self.palette_buffer)
		-- The upload completes asynchronously: the handle is passed to the render script a
		-- few frames later (update), otherwise render.enable_texture rejects it.
		self.palette_announce = 3
	else
		resource.set_texture(self.palette_path, self.palette_header, self.palette_buffer)
	end
end

-- Native simple cycle (0x4cccf0): rotate inclusive low..high right by one entry.
local function rotate(colors, low, high)
	local last = colors[high]
	for i = high, low + 1, -1 do colors[i] = colors[i - 1] end
	colors[low] = last
end

local function cycle_tick(self)
	local changed = false
	for _, c in ipairs(self.cycles) do
		c.counter = c.counter - 1
		if c.counter == 0 then
			c.counter = c.speed
			rotate(self.colors, c.low, c.high)
			changed = true
		end
	end
	return changed
end

local function fill(self, map)
	local url = msg.url("#terrain")
	local t0 = socket.gettime()
	local c = loader.load(GENERATED .. map .. ".kpm")
	local meta = c:section("META")
	local w, h = u16(meta, 0), u16(meta, 2)
	local mtxm = c:section("MTXM")
	local t1 = socket.gettime()
	local megatile = self.megatile
	local floor = math.floor
	local set_tile = tilemap.set_tile
	-- Map row 0 is the top row: it goes to template row TEMPLATE (Defold tile y grows upwards).
	for y = 0, h - 1 do
		local ty = TEMPLATE - y
		local base = y * w * 2
		for x = 0, w - 1 do
			local lo, hi = mtxm:byte(base + x * 2 + 1, base + x * 2 + 2)
			local tile = lo + hi * 256
			local m = megatile[(floor(tile / 16) % 2048) * 16 + tile % 16] or 0
			set_tile(url, "terrain", x + 1, ty, m + 1)
		end
	end
	local t2 = socket.gettime()
	-- Cells of the template outside the map: clear rows below and columns to the right.
	local cleared = 0
	for y = 1, TEMPLATE - h do
		for x = 1, TEMPLATE do set_tile(url, "terrain", x, y, 0); cleared = cleared + 1 end
	end
	for y = TEMPLATE - h + 1, TEMPLATE do
		for x = w + 1, TEMPLATE do set_tile(url, "terrain", x, y, 0); cleared = cleared + 1 end
	end
	local t3 = socket.gettime()
	local bx, by, bw, bh = tilemap.get_bounds(url)
	local ok_out = pcall(set_tile, url, "terrain", TEMPLATE + 1, TEMPLATE, 1)
	local ok_neg = pcall(set_tile, url, "terrain", 0, 1, 1)
	local probe = tilemap.get_tile(url, "terrain", 1, TEMPLATE)
	report.line(("fill map=%s size=%dx%d load_ms=%.2f fill_ms=%.2f cells=%d clear_ms=%.2f cleared=%d bounds=%d,%d,%d,%d set_outside_ok=%s set_zero_ok=%s top_left_tile=%d")
		:format(map, w, h, (t1 - t0) * 1000, (t2 - t1) * 1000, w * h, (t3 - t2) * 1000, cleared,
			bx, by, bw, bh, tostring(ok_out), tostring(ok_neg), probe))
	-- Decode-only cost (no set_tile), to separate Lua work from the tilemap API.
	local t4 = socket.gettime()
	local sum = 0
	for i = 0, w * h - 1 do
		local lo, hi = mtxm:byte(i * 2 + 1, i * 2 + 2)
		local tile = lo + hi * 256
		sum = sum + (megatile[(floor(tile / 16) % 2048) * 16 + tile % 16] or 0)
	end
	report.line(("decode_only map=%s ms=%.2f checksum=%d"):format(map, (socket.gettime() - t4) * 1000, sum))
end

function init(self)
	load_tileset(self, self.tileset == hash("desert") and "desert" or "install")
end

function update(self, dt)
	if self.palette_announce then
		self.palette_announce = self.palette_announce - 1
		if self.palette_announce == 0 then
			self.palette_announce = nil
			-- create_texture returns the path hash; the render script needs the texture handle.
			msg.post("@render:", "set_palette", { handle = resource.get_texture_info(self.palette_path).handle })
		end
	end
	if not self.cycling then return end
	local t0 = socket.gettime()
	local changed = false
	for _ = 1, DRIVER_TICKS_PER_FRAME do changed = cycle_tick(self) or changed end
	if changed then
		upload_palette(self, false)
		self.uploads = self.uploads + 1
	end
	self.cycle_time = self.cycle_time + (socket.gettime() - t0)
	self.cycling = self.cycling - 1
	if self.cycling == 0 then
		report.line(("cycle frames=%d uploads=%d avg_ms_per_frame=%.4f avg_ms_per_upload=%.4f"):format(self.cycle_frames,
			self.uploads, self.cycle_time * 1000 / self.cycle_frames, self.cycle_time * 1000 / math.max(1, self.uploads)))
		self.cycling = nil
		msg.post(self.reply_to, "cycled")
	end
end

function final(self)
	msg.post("@render:", "set_palette", { handle = nil })
	resource.release(self.palette_path)
end

function on_message(self, message_id, message, sender)
	if message_id == hash("fill") then
		fill(self, message.map)
		msg.post(sender, "filled")
	elseif message_id == hash("cycle") then
		self.cycling, self.cycle_frames, self.cycle_time, self.uploads = message.frames, message.frames, 0, 0
		self.reply_to = sender
	end
end
