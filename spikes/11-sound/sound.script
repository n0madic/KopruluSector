-- Spike 11: race sound pack memory (OGG vs WAV, collection factory "Load Dynamically"),
-- sound.play latency, mission speech collection (proxy) load/unload, music streaming.
-- Run twice: spikes/11-sound (stream_enabled = 1) and spikes/11-sound/11-sound-nostream.
local report = require("spikes.common.report")

local LATENCY_SOUNDS = 12
local LATENCY_MAX_MS = 5000 -- skip long speech in the sequential latency test
local MUSIC_SECONDS = 3

local function memory_kb()
	if report.is_web then return -1 end
	local ok, bytes = pcall(profiler.get_memory_usage)
	return ok and math.floor(bytes / 1024) or -1
end

local function wait_frames(n)
	local left = n
	return function()
		left = left - 1
		return left <= 0
	end
end

local function wait_seconds(self, s)
	local until_t
	return function()
		until_t = until_t or socket.gettime() + s
		return socket.gettime() >= until_t
	end
end

local function mem(label)
	return function()
		report.line(("mem %s kb=%d"):format(label, memory_kb()))
		return true
	end
end

-- Plays sounds one after another and compares wall time to the WAV duration.
local function latency_steps(self, pack, url_of)
	local steps, rows, chosen = {}, self.manifest[pack], {}
	for _, row in ipairs(rows) do
		if #chosen < LATENCY_SOUNDS and row.duration_ms <= LATENCY_MAX_MS then chosen[#chosen + 1] = row end
	end
	for _, row in ipairs(chosen) do
		steps[#steps + 1] = function()
			self.waiting = true
			local t0 = socket.gettime()
			self.deadline = t0 + row.duration_ms / 1000 + 2
			sound.play(url_of(row.id), nil, function()
				local wall = (socket.gettime() - t0) * 1000
				report.line(("play pack=%s id=%s duration_ms=%d wall_ms=%.1f excess_ms=%.1f"):format(pack, row.id,
					row.duration_ms, wall, wall - row.duration_ms))
				self.waiting = false
			end)
			report.line(("play_call pack=%s id=%s call_ms=%.3f"):format(pack, row.id, (socket.gettime() - t0) * 1000))
			return true
		end
		steps[#steps + 1] = function()
			if self.waiting and socket.gettime() > self.deadline then
				report.line(("play pack=%s id=%s error=no_completion"):format(pack, row.id))
				self.waiting = false
			end
			return not self.waiting
		end
	end
	-- Eight simultaneous starts (the native channel count) in one frame.
	steps[#steps + 1] = function()
		local t0 = socket.gettime()
		for i = 1, math.min(8, #rows) do sound.play(url_of(rows[i].id)) end
		report.line(("play_burst pack=%s count=8 call_ms=%.3f"):format(pack, (socket.gettime() - t0) * 1000))
		return true
	end
	steps[#steps + 1] = wait_seconds(self, 2)
	return steps
end

local function factory_steps(self, pack)
	local cf = "#" .. pack
	local steps = {
		mem(pack .. "_before"),
		function()
			self.waiting = true
			local t0 = socket.gettime()
			collectionfactory.load(cf, function(_, _, ok)
				report.line(("load pack=%s ok=%s ms=%.1f"):format(pack, tostring(ok), (socket.gettime() - t0) * 1000))
				self.waiting = false
			end)
			return true
		end,
		function() return not self.waiting end,
		wait_frames(2),
		mem(pack .. "_loaded"),
		function() self.ids = collectionfactory.create(cf); return true end,
		wait_frames(2),
	}
	for _, s in ipairs(latency_steps(self, pack, function(id)
		return msg.url(nil, self.ids[hash("/sounds")], id)
	end)) do steps[#steps + 1] = s end
	steps[#steps + 1] = function() go.delete(self.ids); self.ids = nil; return true end
	steps[#steps + 1] = wait_frames(3)
	steps[#steps + 1] = function() collectionfactory.unload(cf); return true end
	steps[#steps + 1] = wait_frames(3)
	steps[#steps + 1] = mem(pack .. "_unloaded")
	return steps
end

local function proxy_steps(self, name, body)
	local url = msg.url("#" .. name)
	local steps = {
		mem(name .. "_before"),
		function() self.waiting = true; self.t0 = socket.gettime(); msg.post(url, "async_load"); return true end,
		function() return not self.waiting end,
		mem(name .. "_loaded"),
		function() msg.post(url, "enable"); return true end,
		wait_frames(2),
	}
	for _, s in ipairs(body) do steps[#steps + 1] = s end
	steps[#steps + 1] = function()
		msg.post(url, "disable"); msg.post(url, "final")
		self.waiting = true; self.t0 = socket.gettime(); msg.post(url, "unload")
		return true
	end
	steps[#steps + 1] = function() return not self.waiting end
	steps[#steps + 1] = wait_frames(3)
	steps[#steps + 1] = mem(name .. "_unloaded")
	return steps
end

function init(self)
	self.manifest = json.decode(sys.load_resource("/generated/spikes/11-sound/sounds.json"))
	report.line(("system=%s engine=%s"):format(sys.get_sys_info().system_name, sys.get_engine_info().version))
	for _, pack in ipairs({ "terran_ogg", "terran_wav", "mission_ogg", "music_ogg" }) do
		local bytes, ms = 0, 0
		for _, row in ipairs(self.manifest[pack]) do bytes, ms = bytes + row.bytes, ms + row.duration_ms end
		report.line(("pack %s sounds=%d file_bytes=%d total_duration_ms=%d"):format(pack, #self.manifest[pack], bytes, ms))
	end
	self.steps = { wait_frames(5), mem("start") }
	local function add(list) for _, s in ipairs(list) do self.steps[#self.steps + 1] = s end end
	add(factory_steps(self, "terran_ogg"))
	add(factory_steps(self, "terran_wav"))
	add(proxy_steps(self, "mission_ogg", latency_steps(self, "mission_ogg", function(id)
		return msg.url("mission_ogg", "/sounds", id)
	end)))
	add(proxy_steps(self, "music_ogg", {
		function() self.music_t0 = socket.gettime(); sound.play(msg.url("music_ogg", "/sounds", "s000")); return true end,
		wait_seconds(self, MUSIC_SECONDS),
		mem("music_playing"),
		function() sound.stop(msg.url("music_ogg", "/sounds", "s000")); return true end,
		wait_frames(3),
	}))
	self.step = 1
end

function update(self, dt)
	if self.finished then return end
	local step = self.steps[self.step]
	if not step then
		self.finished = true
		report.done()
		return
	end
	if step() then self.step = self.step + 1 end
end

function on_message(self, message_id, message, sender)
	if message_id == hash("proxy_loaded") or message_id == hash("proxy_unloaded") then
		report.line(("%s ms=%.1f"):format(message_id == hash("proxy_loaded") and "proxy_loaded" or "proxy_unloaded",
			(socket.gettime() - self.t0) * 1000))
		self.waiting = nil
	end
end
