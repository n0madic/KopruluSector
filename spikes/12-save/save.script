-- Spike 12: binary save files on every platform (plan D17).
--   1. io.open on sys.get_save_file: write 2 MB with every byte value, read back.
--   2. Persistence across launches: the first launch writes a marker; a later launch
--      reports whether the previous marker survived (HTML5: IndexedDB-backed FS).
--   3. sys.save with a binary string inside a table, up to its documented limits.
local snapshot = require("game.simulation.snapshot")
local report = require("spikes.common.report")

local APP = "koprulusector_spike12"
local SIZE = 2 * 1024 * 1024

local function payload(n)
	local chunk = {}
	for i = 0, 255 do chunk[#chunk + 1] = string.char(i) end
	local block = table.concat(chunk)
	return string.rep(block, math.ceil(n / 256)):sub(1, n)
end

local function write_file(path, data)
	local f, err = io.open(path, "wb")
	if not f then return false, err end
	f:write(data)
	f:close()
	return true
end

local function read_file(path)
	local f = io.open(path, "rb")
	if not f then return nil end
	local data = f:read("*a")
	f:close()
	return data
end

function init(self)
	report.line("platform " .. sys.get_sys_info().system_name)
	local data = payload(SIZE)
	local path = sys.get_save_file(APP, "state.bin")
	report.line("save path " .. path)

	local marker_path = sys.get_save_file(APP, "marker.bin")
	local previous = read_file(marker_path)
	report.line("marker from a previous launch: " .. (previous and ("present, fingerprint 0x%08x"):format(snapshot.fnv1a(previous)) or "absent"))

	local t0 = socket.gettime()
	local ok, err = write_file(path, data)
	local t1 = socket.gettime()
	local back = ok and read_file(path)
	local t2 = socket.gettime()
	report.line(("io write %d bytes: %s, %.1f ms"):format(SIZE, ok and "ok" or ("failed: " .. tostring(err)), (t1 - t0) * 1000))
	report.line(("io read back: %s, %.1f ms"):format(back == data and "identical" or "MISMATCH", (t2 - t1) * 1000))

	local marker = payload(4096) .. tostring(os.time())
	write_file(marker_path, marker)
	report.line(("marker written, fingerprint 0x%08x"):format(snapshot.fnv1a(marker)))

	-- sys.save with binary strings (settings/progress path, plan D17).
	for _, n in ipairs({ 64 * 1024, 400 * 1024, 600 * 1024 }) do
		local file = sys.get_save_file(APP, "table" .. n .. ".sav")
		local okk, res = pcall(sys.save, file, { blob = payload(n) })
		local loaded = okk and res and sys.load(file)
		report.line(("sys.save table with %d-byte string: %s"):format(n,
			not okk and ("error: " .. tostring(res)) or (loaded and loaded.blob == payload(n)) and "round-trip ok" or "round-trip FAILED"))
	end
	-- sys.save also flushes the HTML5 file system to IndexedDB.
	sys.save(sys.get_save_file(APP, "flush.sav"), { t = os.time() })
	report.done()
end
