-- Spike 6, effect set: original cloak/EMP distortion, threshold, trans50, warp texture
-- and size outline kernels on
-- 640x480 buffers (20 tiles per frame), byte-checked on HTML5 against the original
-- results (spikes/06-palette/prepare_effects.py).
local kpf = require("game.data.kpf")
local bytes = require("game.data.bytes")
local report = require("spikes.common.report")
local reader = require("spikes.06-palette.reader")

local DIR = "/spikes/06-palette/generated/effects/"
local CASE_SIZE, STAGE_SIZE = 24, 8

local function texture(name)
	local img = image.load_buffer(sys.load_resource(DIR .. name))
	return resource.create_texture("/sp06e/" .. name:gsub("%.png$", "") .. ".texturec", {
		type = graphics.TEXTURE_TYPE_2D, width = img.width, height = img.height, format = graphics.TEXTURE_FORMAT_RGBA,
	}, img.buffer)
end

local function hex(s)
	return (s:gsub(".", function(c) return ("%02x"):format(c:byte()) end))
end

function init(self)
	report.line("platform " .. sys.get_sys_info().system_name)
	local c = kpf.parse(sys.load_resource(DIR .. "cases.kpd"), "cases.kpd")
	local geom = c:section("GEOM")
	self.tile_w, self.tile_h, self.per_row, self.rows = bytes.u16(geom, 0), bytes.u16(geom, 2), bytes.u16(geom, 4), bytes.u16(geom, 6)
	self.per_batch = self.per_row * self.rows
	self.frames, self.cases, self.stages, self.hashes = c:section("FRMS"), c:section("CASE"), c:section("STAG"), c:section("HASH")
	self.count = #self.cases / CASE_SIZE
	-- Stages grouped by case, in draw order.
	self.case_stages = {}
	for k = 0, #self.stages / STAGE_SIZE - 1 do
		local case = bytes.u32(self.stages, k * STAGE_SIZE)
		local list = self.case_stages[case] or {}
		list[#list + 1] = bytes.u8(self.stages, k * STAGE_SIZE + 4)
		self.case_stages[case] = list
	end
	msg.post("@render:", "sp06_tile", { width = self.tile_w, height = self.tile_h, set = 1 })
	msg.post("@render:", "sp06_textures", { frames = texture("frames.png"), tables = texture("tables.png") })
	self.vertices = go.get("#effects", "vertices")
	self.next_case, self.pending = 0, nil
	if report.is_web then
		local corner_row, i = self.tile_h - 1, (self.tile_h - 1) * self.tile_w + 310
		reader.install(self.tile_w, self.tile_h, self.per_row, (i * 17 + corner_row * 31) % 256)
	end
	self.t_start = socket.gettime()
end

local function build_batch(self, first)
	local n = math.min(self.per_batch, self.count - first)
	local quads = {}
	for t = 0, n - 1 do
		for _, stage in ipairs(self.case_stages[first + t]) do quads[#quads + 1] = { t, first + t, stage } end
	end
	-- All first stages before second stages keeps per-tile order (stages of one case
	-- are adjacent in `quads` already; tiles do not overlap).
	local buf = buffer.create(#quads * 6, {
		{ name = hash("position"), type = buffer.VALUE_TYPE_FLOAT32, count = 3 },
		{ name = hash("texcoord0"), type = buffer.VALUE_TYPE_FLOAT32, count = 2 },
		{ name = hash("place"), type = buffer.VALUE_TYPE_FLOAT32, count = 4 },
		{ name = hash("shape"), type = buffer.VALUE_TYPE_FLOAT32, count = 4 },
		{ name = hash("source"), type = buffer.VALUE_TYPE_FLOAT32, count = 4 },
		{ name = hash("extra"), type = buffer.VALUE_TYPE_FLOAT32, count = 4 },
		{ name = hash("normal"), type = buffer.VALUE_TYPE_FLOAT32, count = 3 },
	})
	local s = {}
	for _, name in ipairs({ "position", "texcoord0", "place", "shape", "source", "extra", "normal" }) do
		s[name] = buffer.get_stream(buf, hash(name))
		-- buffer.create does not zero its memory; not every stream is written below.
		for k = 1, #s[name] do s[name][k] = 0 end
	end
	local v = 0
	for _, q in ipairs(quads) do
		local t, case, stage = q[1], q[2], q[3]
		local o = case * CASE_SIZE
		local fid = bytes.u32(self.cases, o)
		local x, y, left, top, cw, ch, arg = bytes.u16(self.cases, o + 4), bytes.u16(self.cases, o + 6), bytes.u16(self.cases, o + 8),
			bytes.u16(self.cases, o + 10), bytes.u16(self.cases, o + 12), bytes.u16(self.cases, o + 14), bytes.u16(self.cases, o + 16)
		local mirror, map_row = bytes.u8(self.cases, o + 20), bytes.u16(self.cases, o + 22)
		local aux = bytes.u16(self.cases, o + 18) -- texture frame of the warp stage
		local fo, ao = fid * 8, aux * 8
		local fx, fy, fw, fh = bytes.u16(self.frames, fo), bytes.u16(self.frames, fo + 2), bytes.u16(self.frames, fo + 4), bytes.u16(self.frames, fo + 6)
		local ax, ay = bytes.u16(self.frames, ao), bytes.u16(self.frames, ao + 2)
		local ox, oy = (t % self.per_row) * self.tile_w, math.floor(t / self.per_row) * self.tile_h
		local x0, x1 = ox + x, ox + x + cw
		local y_top, y_bottom = oy + self.tile_h - y, oy + self.tile_h - y - ch
		if ch == 0 then x1, y_top = x0, y_bottom end
		local corners = { { x0, y_bottom }, { x1, y_bottom }, { x1, y_top }, { x0, y_bottom }, { x1, y_top }, { x0, y_top } }
		for _, k in ipairs(corners) do
			local p, a = v * 3, v * 4
			s.position[p + 1], s.position[p + 2], s.position[p + 3] = k[1], k[2], 0
			s.place[a + 1], s.place[a + 2], s.place[a + 3], s.place[a + 4] = x, y, left, top
			s.shape[a + 1], s.shape[a + 2], s.shape[a + 3], s.shape[a + 4] = cw, ch, fw, mirror
			s.source[a + 1], s.source[a + 2], s.source[a + 3], s.source[a + 4] = fx, fy, stage, arg
			s.extra[a + 1], s.extra[a + 2], s.extra[a + 3], s.extra[a + 4] = map_row, ax, ay, fh
			v = v + 1
		end
	end
	resource.set_buffer(self.vertices, buf)
	return n
end

local function expected_js(self, first, n)
	local parts = {}
	for t = 0, n - 1 do
		local id = first + t
		parts[#parts + 1] = ("{id:%d,hash:'%s'}"):format(id, hex(self.hashes:sub(id * 32 + 1, id * 32 + 32)))
	end
	return "[" .. table.concat(parts, ",") .. "]"
end

function update(self)
	if self.pending and report.is_web then reader.read(self.pending.n, expected_js(self, self.pending.first, self.pending.n)) end
	self.pending = nil
	if self.next_case >= self.count then
		if not self.finished then
			self.finished = true
			report.line(("drew %d effect cases in %d batches, %.1f s"):format(self.count, math.ceil(self.count / self.per_batch), socket.gettime() - self.t_start))
			if report.is_web then reader.finish() else report.done() end
		end
		return
	end
	local n = build_batch(self, self.next_case)
	self.pending = { first = self.next_case, n = n }
	self.next_case = self.next_case + n
end
