-- Spike 10 inside Defold: buffer-stream access, async loading of a mission-sized
-- container, section extraction and Lua heap after loading.
local bench = require("spikes.10-data.bench")
local loader = require("game.data.loader")
local report = require("spikes.common.report")

local MISSION = "/spikes/10-data/generated/mission.kpm"
local LARGE = "/tests/fixtures/generated/kpf/large.kpd"

local function clock()
	return socket.gettime()
end

local out = report.line

local function stream_of(s)
	local n = #s / 2
	local buf = buffer.create(n, { { name = hash("v"), type = buffer.VALUE_TYPE_UINT16, count = 1 } })
	local stream = buffer.get_stream(buf, hash("v"))
	for i = 1, n do
		local lo, hi = s:byte(i * 2 - 1, i * 2)
		stream[i] = lo + hi * 256
	end
	return stream
end

local function load_timed(self, path, done)
	local t0 = clock()
	loader.load_async(path, function(self, c, err)
		assert(c, err)
		done(self, c, (clock() - t0) * 1000)
	end)
end

function init(self)
	local info = sys.get_sys_info()
	out(("platform %s, %s"):format(info.system_name, jit and jit.version or _VERSION))
	for _, line in ipairs(bench.format(bench.run({ clock = clock, stream = stream_of }))) do out(line) end

	collectgarbage("collect")
	self.heap0 = collectgarbage("count")
	load_timed(self, MISSION, function(self, c, ms)
		out(("load_async mission.kpm %d bytes: %.1f ms"):format(#c.data, ms))
		local t0 = clock()
		local sections = {}
		for _, s in ipairs(c.sections) do sections[s.fourcc] = c:section(s.fourcc) end
		out(("extract %d sections: %.1f ms"):format(#c.sections, (clock() - t0) * 1000))
		collectgarbage("collect")
		out(("heap after load+extract: +%.0f KB (file %d KB)"):format(collectgarbage("count") - self.heap0, #c.data / 1024))
		self.keep = sections
		c.data = nil
		collectgarbage("collect")
		out(("heap with sections only: +%.0f KB"):format(collectgarbage("count") - self.heap0))
		load_timed(self, LARGE, function(self, big, big_ms)
			out(("load_async large.kpd %d bytes: %.1f ms"):format(#big.data, big_ms))
			report.done()
		end)
	end)
end
