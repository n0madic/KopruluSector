-- Spike 14: game clock under the real Defold loop. Runs for RUN_SECONDS of wall time,
-- pausing on focus loss / iconify and resetting on resume. An external driver hides
-- and shows the app (macOS: osascript; Android: HOME + relaunch) during the run.
-- A 1-second stall is injected to check the catch-up bound.
local clock = require("game.simulation.clock")
local report = require("spikes.common.report")

local RUN_SECONDS = 14
local STALL_AT = 2.0

local EVENT_NAMES = {}

local function now()
	return socket.gettime()
end

function init(self)
	for _, name in ipairs({ "WINDOW_EVENT_FOCUS_LOST", "WINDOW_EVENT_FOCUS_GAINED", "WINDOW_EVENT_ICONFIED",
		"WINDOW_EVENT_DEICONIFIED", "WINDOW_EVENT_RESIZED" }) do
		if window[name] then EVENT_NAMES[window[name]] = name end
	end
	self.clock = clock.new()
	self.t0 = now()
	self.paused_since = nil
	self.paused_total = 0
	self.max_steps = 0
	self.frames = 0
	self.stalled = false
	window.set_listener(function(_, event, data)
		local t = now() - self.t0
		report.line(("event %s at %.2f s"):format(EVENT_NAMES[event] or tostring(event), t))
		if event == window.WINDOW_EVENT_FOCUS_LOST or event == window.WINDOW_EVENT_ICONFIED then
			if not self.clock.paused then
				self.clock:pause()
				self.paused_since = now()
			end
		elseif event == window.WINDOW_EVENT_FOCUS_GAINED or event == window.WINDOW_EVENT_DEICONIFIED then
			if self.clock.paused then
				self.paused_total = self.paused_total + (now() - self.paused_since)
				self.clock:resume()
			end
		end
	end)
	report.line(("platform %s"):format(sys.get_sys_info().system_name))
end

function update(self, dt)
	self.frames = self.frames + 1
	local elapsed = now() - self.t0
	if not self.stalled and elapsed > STALL_AT then
		self.stalled = true
		local t = now()
		while now() - t < 1.0 do end -- 1 s stall in one frame
	end
	-- Engine dt versus measured wall delta: the clock is driven by the wall delta.
	local wall = now()
	local wall_dt = self.last_wall and (wall - self.last_wall) or dt
	self.last_wall = wall
	if self.stalled and not self.reported_stall then
		self.reported_stall = true
		report.line(("frame after stall: engine dt %.3f s, wall dt %.3f s"):format(dt, wall_dt))
	end
	local n = self.clock:advance_wall(wall)
	if n > self.max_steps then self.max_steps = n end
	if elapsed > RUN_SECONDS then
		local active = elapsed - self.paused_total
		report.line(("frames %d, steps %d, max steps per frame %d"):format(self.frames, self.clock.steps, self.max_steps))
		report.line(("wall %.2f s, paused %.2f s, active %.2f s, ideal steps %d"):format(
			elapsed, self.paused_total, active, math.floor(active * 1000 / 42)))
		report.line(("dropped backlog %.0f ms, resumes %d"):format(self.clock.dropped_ms, self.clock.resets))
		report.done()
		self.finished = true
		RUN_SECONDS = math.huge
	end
end
