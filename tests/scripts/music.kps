# The music's tracks through the glue (issue #3; docs/phase-script.md): the title's in the menus; a ready room's
# Cancel stops the room's track and plays the title's again (RunTerranReadyRoom 0x461420's 0x460ee0); the room's
# Start leaves its track until RunGame 0x443f40 stops it for the game's (terran: 1..3); the menus after a game play
# the title's; a save loaded from the glue plays its game's track. tools/ci.sh wants exit code 0 and "0 failures".
options originals
clock real

wait screen gluMain
wait music.playing == 1 and music.track == 22 within 5000

click control glumain.single
wait dialog gluGameMode and still
click control glugamemode.original
wait dialog gluPEdit and still
text "Script"
click control gluPEdit.1
wait screen gluLogin
click control glulogin.ok
wait screen gluCmpgn
expect music.playing == 1 and music.track == 22

# the Terran episode's room and its Cancel
click control gluCmpgn.7
wait episode
wait room and still
click center
until briefing every 1 key Escape
wait music.playing == 1 and music.track == 11 within 5000
click control glurdyt.14
wait screen gluCmpgn and still
wait music.playing == 1 and music.track == 22 within 5000

# the room again, its Start: the game's track
click control gluCmpgn.7
wait episode
wait room and still
click center
until briefing every 1 key Escape
click control glurdyt.13
wait game
wait music.playing == 1 and music.track >= 4 and music.track <= 6 within 5000
save "music"
wait frames 30

# the mission quit: the menus' title again
until nodialog key Escape
menu quit-mission
wait dialog quit2mnu
activate ok
wait screen gluCmpgn
wait music.playing == 1 and music.track == 22 within 5000

# the save loaded from the glue: its game's track, not the title's
click control glucmpgn.load
wait screen gluLoad and still
click control gluload.ok
wait game
wait music.playing == 1 and music.track >= 4 and music.track <= 6 within 5000
log loaded music.playing music.track
