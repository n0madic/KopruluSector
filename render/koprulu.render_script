-- KopruluSector render pipeline (plan D10, §2.1):
--   1. terrain, then world images -> index render target (palette index in R; RGBA8 because
--      Defold has no R8 render-target format). Images are composed by depth rank (ADR 0006):
--      overwriting images write their rank as depth with test GREATER, so the image last in
--      the native draw order wins whatever its mesh; destination images (shadow, blends,
--      fire) test without writing, one layer at a time, each layer reading a fresh copy of
--      the index target;
--   2. palette pass: index -> RGB through a 256-entry constant array (kp_palette);
--   3. scaling to the window: "integer" (nearest, integer factor, world size grows with
--      the window), "sharp" (fixed visible height, sharp-bilinear upscale) or "auto"
--      (default: integer from a 2x scale up, otherwise sharp);
--   4. GUI in window pixels on top.
-- Debug overlays (material tag kp_overlay, RGBA) are drawn in world space between steps 2 and 3.
-- Messages (to "@render:"): kp_textures {remap=, tables=} (texture resource paths),
-- kp_world_textures {atlases = {[slot 0..5] = path}, image_data=, frame_table=} (world images;
-- an empty message stops drawing them),
-- kp_world_frame {interp=, layers=} (per frame: tick interpolation, destination layers),
-- kp_palette {rgb=} (768 bytes, R, G, B per index; at most once per frame is useful),
-- kp_scale_mode {mode="auto"|"integer"|"sharp", visible_height=}, kp_camera {x=, y=}.
local MSG_TEXTURES = hash("kp_textures")
local MSG_PALETTE = hash("kp_palette")
local MSG_SCALE_MODE = hash("kp_scale_mode")
local MSG_CAMERA = hash("kp_camera")
local MSG_STATS = hash("kp_stats")
local MSG_WORLD_TEXTURES = hash("kp_world_textures")
local MSG_WORLD_FRAME = hash("kp_world_frame")

local world_depth = require("presentation.backend.world_depth")

local ATLAS_SLOTS = 6
local RANK_RANGE = world_depth.RANK_RANGE

local DEFAULT_VISIBLE_HEIGHT = 480

local draw_images

local function target(width, height, filter, depth)
	local buffers = {
		[graphics.BUFFER_TYPE_COLOR0_BIT] = {
			format = graphics.TEXTURE_FORMAT_RGBA,
			width = width,
			height = height,
			min_filter = filter,
			mag_filter = filter,
			u_wrap = graphics.TEXTURE_WRAP_CLAMP_TO_EDGE,
			v_wrap = graphics.TEXTURE_WRAP_CLAMP_TO_EDGE,
		},
	}
	if depth then
		buffers[graphics.BUFFER_TYPE_DEPTH_BIT] = { format = graphics.TEXTURE_FORMAT_DEPTH, width = width, height = height }
	end
	return render.render_target(buffers)
end

-- World (index target) size and output viewport for the current window.
-- A hidden browser canvas reports a zero size; the targets keep at least one texel and
-- update() relayouts on the first real size.
local function layout(self, win_w, win_h)
	win_w, win_h = math.max(1, win_w), math.max(1, win_h)
	local visible = self.visible_height
	-- "auto" (default): integer nearest from a 2x scale up, sharp bilinear below that
	-- (docs/spikes/13-screen.md).
	local mode = self.requested_mode
	if mode == "auto" then mode = (win_h >= 2 * visible) and "integer" or "sharp" end
	self.mode = mode
	if mode == "integer" then
		local scale = math.max(1, math.floor(win_h / visible + 0.5))
		self.scale = scale
		self.world_w = math.ceil(win_w / scale)
		self.world_h = math.ceil(win_h / scale)
	else
		self.scale = win_h / visible
		self.world_h = visible
		self.world_w = math.ceil(visible * win_w / win_h)
	end
	if self.index_rt then
		render.set_render_target_size(self.index_rt, self.world_w, self.world_h)
		render.set_render_target_size(self.rgb_rt, self.world_w, self.world_h)
		render.set_render_target_size(self.dest_rt, self.world_w, self.world_h)
	else
		self.index_rt = target(self.world_w, self.world_h, graphics.TEXTURE_FILTER_NEAREST, true)
		self.rgb_rt = target(self.world_w, self.world_h, graphics.TEXTURE_FILTER_LINEAR)
		self.dest_rt = target(self.world_w, self.world_h, graphics.TEXTURE_FILTER_NEAREST)
	end
	self.win_w, self.win_h = win_w, win_h
end

-- Debug overlays (kp_overlay) in world space, alpha-blended over the RGB result.
local function draw_overlays(self, width, height)
	render.set_viewport(0, 0, width, height)
	render.set_view(vmath.matrix4_translation(vmath.vector3(-self.camera_x, -self.camera_y, 0)))
	render.set_projection(vmath.matrix4_orthographic(0, self.world_w, 0, self.world_h, -1, 1))
	render.enable_state(graphics.STATE_BLEND)
	render.set_blend_func(graphics.BLEND_FACTOR_SRC_ALPHA, graphics.BLEND_FACTOR_ONE_MINUS_SRC_ALPHA)
	render.draw(self.pred.overlay)
	render.disable_state(graphics.STATE_BLEND)
	render.set_view(self.identity)
	render.set_projection(self.identity)
end

local function bind_world_textures(self, on)
	local t = self.world_textures
	for slot = 0, ATLAS_SLOTS - 1 do
		local name = "atlas" .. slot
		if on then render.enable_texture(name, t.atlases[slot] or t.any_atlas) else render.disable_texture(name) end
	end
	if on then
		render.enable_texture("image_data", t.image_data)
		render.enable_texture("frame_table", t.frame_table)
	else
		render.disable_texture("image_data")
		render.disable_texture("frame_table")
	end
end

local function layer_constants(self, layer)
	local c = self.layer_constants[layer]
	if not c then
		c = render.constant_buffer()
		c.window = vmath.vector4(0, RANK_RANGE, layer, 1)
		c.depth = self.world_constants.depth
		self.layer_constants[layer] = c
	end
	c.interp = self.world_constants.interp
	return c
end

-- World images by depth rank (ADR 0006): overwriting images, then each destination layer
-- after a fresh copy of the index target.
draw_images = function(self, view, projection)
	bind_world_textures(self, true)
	render.enable_state(graphics.STATE_DEPTH_TEST)
	render.set_depth_func(graphics.COMPARE_FUNC_GREATER)
	render.set_depth_mask(true)
	render.draw(self.pred.images, { constants = self.world_constants })
	render.set_depth_mask(false)
	if self.world_layers > 0 and self.tables then
		render.enable_texture("tables", self.tables)
		for layer = 1, self.world_layers do
			render.disable_state(graphics.STATE_DEPTH_TEST)
			render.set_render_target(self.dest_rt)
			render.set_view(self.identity)
			render.set_projection(self.identity)
			render.enable_texture("source_target", self.index_rt, graphics.BUFFER_TYPE_COLOR0_BIT)
			render.draw(self.pred.copy)
			render.disable_texture("source_target")
			render.set_render_target(self.index_rt)
			render.set_view(view)
			render.set_projection(projection)
			render.enable_state(graphics.STATE_DEPTH_TEST)
			render.enable_texture("dest", self.dest_rt, graphics.BUFFER_TYPE_COLOR0_BIT)
			render.draw(self.pred.images_dest, { constants = layer_constants(self, layer) })
			render.disable_texture("dest")
		end
		render.disable_texture("tables")
	end
	render.set_depth_mask(true)
	render.disable_state(graphics.STATE_DEPTH_TEST)
	bind_world_textures(self, false)
end

function init(self)
	self.pred = {
		terrain = render.predicate({ "kp_terrain" }),
		world = render.predicate({ "kp_world" }),
		images = render.predicate({ "kp_images" }),
		images_dest = render.predicate({ "kp_images_dest" }),
		world_dest = render.predicate({ "kp_world_dest" }),
		copy = render.predicate({ "kp_copy" }),
		palette = render.predicate({ "kp_palette" }),
		overlay = render.predicate({ "kp_overlay" }),
		sharp = render.predicate({ "kp_sharp_bilinear" }),
		gui = render.predicate({ "gui" }),
		text = render.predicate({ "text" }),
		debug_text = render.predicate({ "debug_text" }),
	}
	self.requested_mode = "auto"
	self.visible_height = DEFAULT_VISIBLE_HEIGHT
	self.camera_x, self.camera_y = 0, 0
	self.constants = render.constant_buffer()
	self.palette_colors = {}
	for i = 1, 256 do self.palette_colors[i] = vmath.vector4(0, 0, 0, 1) end
	self.constants.palette_colors = self.palette_colors
	self.palette_ms = 0
	self.clear_index = { [graphics.BUFFER_TYPE_COLOR0_BIT] = vmath.vector4(0, 0, 0, 0),
		[graphics.BUFFER_TYPE_DEPTH_BIT] = 0 }
	self.world_constants = render.constant_buffer()
	self.world_constants.interp = vmath.vector4(1, 0, 0, 0)
	self.world_constants.window = vmath.vector4(0, RANK_RANGE, 0, 0)
	self.world_constants.depth = vmath.vector4(1 / RANK_RANGE, 0, 0, 0)
	self.layer_constants = {}
	self.world_layers = 0
	self.clear_screen = { [graphics.BUFFER_TYPE_COLOR0_BIT] = vmath.vector4(0, 0, 0, 1) }
	self.identity = vmath.matrix4()
	layout(self, render.get_window_width(), render.get_window_height())
end

function update(self)
	local win_w, win_h = render.get_window_width(), render.get_window_height()
	if win_w == 0 or win_h == 0 then return end
	if win_w ~= self.win_w or win_h ~= self.win_h then layout(self, win_w, win_h) end

	render.disable_state(graphics.STATE_DEPTH_TEST)
	render.disable_state(graphics.STATE_BLEND)
	render.disable_state(graphics.STATE_CULL_FACE)

	-- 1. Terrain and world images into the index target.
	render.set_render_target(self.index_rt)
	render.set_viewport(0, 0, self.world_w, self.world_h)
	render.clear(self.clear_index)
	local view = vmath.matrix4_translation(vmath.vector3(-self.camera_x, -self.camera_y, 0))
	local projection = vmath.matrix4_orthographic(0, self.world_w, 0, self.world_h, -1, 1)
	render.set_view(view)
	render.set_projection(projection)
	render.draw(self.pred.terrain)
	if self.remap then render.enable_texture("remap_table", self.remap) end
	render.draw(self.pred.world) -- legacy single-mesh batches (phase 0 spikes)
	if self.world_textures then
		draw_images(self, view, projection)
	end
	if self.remap then render.disable_texture("remap_table") end

	-- 1b. Legacy destination-reading batches (phase 0 spikes): one snapshot, one run.
	if self.tables and not self.world_textures then
		render.set_render_target(self.dest_rt)
		render.set_view(self.identity)
		render.set_projection(self.identity)
		render.enable_texture("source_target", self.index_rt, graphics.BUFFER_TYPE_COLOR0_BIT)
		render.draw(self.pred.copy)
		render.disable_texture("source_target")
		render.set_render_target(self.index_rt)
		render.set_view(view)
		render.set_projection(projection)
		render.enable_texture("dest", self.dest_rt, graphics.BUFFER_TYPE_COLOR0_BIT)
		render.enable_texture("tables", self.tables)
		render.draw(self.pred.world_dest)
		render.disable_texture("tables")
		render.disable_texture("dest")
	end

	-- 2./3. Palette pass and scaling.
	render.set_view(self.identity)
	render.set_projection(self.identity)
	self.constants.source_size = vmath.vector4(self.world_w, self.world_h, self.scale, self.scale)
	render.enable_texture("index_target", self.index_rt, graphics.BUFFER_TYPE_COLOR0_BIT)
	if self.mode == "integer" then
		render.set_render_target(render.RENDER_TARGET_DEFAULT)
		render.set_viewport(0, 0, self.world_w * self.scale, self.world_h * self.scale)
		render.draw(self.pred.palette, { constants = self.constants })
		draw_overlays(self, self.world_w * self.scale, self.world_h * self.scale)
	else
		render.set_render_target(self.rgb_rt)
		render.set_viewport(0, 0, self.world_w, self.world_h)
		render.draw(self.pred.palette, { constants = self.constants })
		draw_overlays(self, self.world_w, self.world_h)
		render.set_render_target(render.RENDER_TARGET_DEFAULT)
		render.set_viewport(0, 0, win_w, win_h)
		render.enable_texture("rgb_target", self.rgb_rt, graphics.BUFFER_TYPE_COLOR0_BIT)
		render.draw(self.pred.sharp, { constants = self.constants })
		render.disable_texture("rgb_target")
	end
	render.disable_texture("index_target")

	-- 4. GUI in window pixels.
	render.set_viewport(0, 0, win_w, win_h)
	render.set_view(self.identity)
	render.set_projection(vmath.matrix4_orthographic(0, win_w, 0, win_h, -1, 1))
	render.enable_state(graphics.STATE_BLEND)
	render.set_blend_func(graphics.BLEND_FACTOR_ONE, graphics.BLEND_FACTOR_ONE_MINUS_SRC_ALPHA)
	render.enable_state(graphics.STATE_STENCIL_TEST)
	render.draw(self.pred.gui)
	render.draw(self.pred.text)
	render.draw(self.pred.debug_text)
	render.disable_state(graphics.STATE_STENCIL_TEST)
	render.disable_state(graphics.STATE_BLEND)
end

function on_message(self, message_id, message, sender)
	if message_id == MSG_TEXTURES then
		if message.remap then self.remap = resource.get_texture_info(message.remap).handle end
		if message.tables then self.tables = resource.get_texture_info(message.tables).handle end
	elseif message_id == MSG_PALETTE then
		local t0 = socket.gettime()
		local rgb, colors = message.rgb, self.palette_colors
		for i = 0, 255 do
			local r, g, b = rgb:byte(i * 3 + 1, i * 3 + 3)
			local c = colors[i + 1]
			c.x, c.y, c.z = r / 255, g / 255, b / 255
		end
		self.constants.palette_colors = colors
		self.palette_ms = (socket.gettime() - t0) * 1000
	elseif message_id == MSG_SCALE_MODE then
		self.requested_mode = message.mode or self.requested_mode
		self.visible_height = message.visible_height or self.visible_height
		layout(self, render.get_window_width(), render.get_window_height())
	elseif message_id == MSG_CAMERA then
		self.camera_x, self.camera_y = message.x, message.y
	elseif message_id == MSG_WORLD_TEXTURES then
		-- An empty message clears the world textures before their owner releases them.
		if not message.atlases then
			self.world_textures = nil
			return
		end
		local t = { atlases = {} }
		for slot = 0, ATLAS_SLOTS - 1 do
			local path = message.atlases[slot]
			if path then
				t.atlases[slot] = resource.get_texture_info(path).handle
				t.any_atlas = t.any_atlas or t.atlases[slot]
			end
		end
		t.image_data = resource.get_texture_info(message.image_data).handle
		t.frame_table = resource.get_texture_info(message.frame_table).handle
		self.world_textures = t.any_atlas and t or nil
	elseif message_id == MSG_WORLD_FRAME then
		self.world_constants.interp.x = message.interp or 1
		self.world_layers = message.layers or 0
	elseif message_id == MSG_STATS then
		msg.post(sender, "kp_stats", { world_w = self.world_w, world_h = self.world_h, scale = self.scale,
			mode = self.mode, win_w = self.win_w, win_h = self.win_h, palette_ms = self.palette_ms })
	end
end
