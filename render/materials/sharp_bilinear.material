name: "sharp_bilinear"
tags: "kp_sharp_bilinear"
vertex_program: "/render/materials/fullscreen.vp"
fragment_program: "/render/materials/sharp_bilinear.fp"
vertex_space: VERTEX_SPACE_LOCAL
fragment_constants {
  name: "source_size"
  type: CONSTANT_TYPE_USER
  value {
    x: 640.0
    y: 480.0
    z: 1.0
    w: 1.0
  }
}
samplers {
  name: "rgb_target"
  wrap_u: WRAP_MODE_CLAMP_TO_EDGE
  wrap_v: WRAP_MODE_CLAMP_TO_EDGE
  filter_min: FILTER_MODE_MIN_LINEAR
  filter_mag: FILTER_MODE_MAG_LINEAR
  max_anisotropy: 1.0
}
