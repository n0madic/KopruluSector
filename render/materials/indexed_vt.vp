#version 140

// Vertex-texture image batch: the mesh holds static (slot, corner) pairs; per-image
// data comes from a float texture written from Lua once per simulation tick, only where
// it changed (ADR 0002):
//   image_data[2 slot]     = (x, y, x - previous x, y - previous y)  (1/256 world pixels)
//   image_data[2 slot + 1] = (remap row * 65536 + frame * 2 + hflip, -, -, -)
// Units and packing keep every value an exact float32 integer and minimise the number of
// elements that change per tick (a still image changes none of the position texel).
//   frame_table[2f]  = (u0, v0, u1, v1), frame_table[2f+1] = (width, height, rotated, -)
// rotated = 1 for a frame bob packed turned by 90 degrees: the texture axes are swapped.
// Positions are interpolated here with interp.x = alpha between ticks, so frames
// between ticks need no texture upload. A zero-sized frame collapses unused slots.
in highp vec4 position; // x = slot, y = corner 0..5

out mediump vec2 var_texcoord0;
flat out mediump vec4 var_remap;

uniform highp sampler2D image_data;
uniform highp sampler2D frame_table;

uniform vs_uniforms
{
    highp mat4 view_proj;
    highp vec4 interp;
};

const int DATA_WIDTH = 256;

void main()
{
    int slot = int(position.x + 0.5);
    int corner = int(position.y + 0.5);
    int texel = slot * 2;
    vec4 pos = texelFetch(image_data, ivec2(texel % DATA_WIDTH, texel / DATA_WIDTH), 0);
    vec4 d = texelFetch(image_data, ivec2((texel + 1) % DATA_WIDTH, (texel + 1) / DATA_WIDTH), 0);
    int packed = int(d.x + 0.5);
    int code = packed % 65536;
    float row = float(packed / 65536);
    int frame = code / 2;
    bool flip = (code % 2) == 1;
    vec4 uv = texelFetch(frame_table, ivec2(frame * 2, 0), 0);
    vec4 size = texelFetch(frame_table, ivec2(frame * 2 + 1, 0), 0);
    // corners: 0 (0,0) 1 (1,0) 2 (1,1) 3 (0,0) 4 (1,1) 5 (0,1)
    float cx = (corner == 1 || corner == 2 || corner == 4) ? 1.0 : 0.0;
    float cy = (corner == 2 || corner == 4 || corner == 5) ? 1.0 : 0.0;
    vec2 p = (pos.xy - (1.0 - interp.x) * pos.zw) / 256.0 + (vec2(cx, cy) - 0.5) * size.xy;
    gl_Position = view_proj * vec4(p, 0.0, 1.0);
    float fx = flip ? 1.0 - cx : cx;
    bool rotated = size.z > 0.5;
    float u = mix(uv.x, uv.z, rotated ? cy : fx);
    float v = mix(uv.w, uv.y, rotated ? fx : cy);
    var_texcoord0 = vec2(u, v);
    var_remap = vec4(row, 0.0, 0.0, 0.0);
}
