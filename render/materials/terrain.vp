#version 140

in highp vec4 position;
// highp texture coordinates: the megatile sheet is 4080 texels wide, where fp16 mediump
// cannot address single texels (the same reason as world.vp, ADR 0006).
in highp vec2 texcoord0;

out highp vec2 var_texcoord0;

uniform vs_uniforms
{
    highp mat4 view_proj;
};

void main()
{
    gl_Position = view_proj * vec4(position.xyz, 1.0);
    var_texcoord0 = texcoord0;
}
