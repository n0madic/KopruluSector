#version 140

// Indexed world images: position in world pixels, atlas UV, per-image attributes.
in highp vec4 position;
in mediump vec2 texcoord0;
in mediump vec4 remap; // x = remap row (player colour / selection / shift), y = draw method

out mediump vec2 var_texcoord0;
flat out mediump vec4 var_remap;

uniform vs_uniforms
{
    highp mat4 view_proj;
};

void main()
{
    gl_Position = view_proj * vec4(position.xyz, 1.0);
    var_texcoord0 = texcoord0;
    var_remap = remap;
}
